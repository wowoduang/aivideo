# -*- coding: utf-8 -*-
from __future__ import annotations

"""
scene_boundary_context.py

scene_boundary_context API schema。

只描述请求/响应结构，不做业务逻辑。
"""

from typing import Any

from pydantic import BaseModel, Field


class SceneBoundaryContextPreviewRequest(BaseModel):
    """场景边界预览请求。"""

    video_path: str = Field(..., description="本地视频文件路径。")
    subtitle_segments: list[dict[str, Any]] = Field(..., description="字幕片段列表，必须包含 start/end/text。")
    visual_anchors: list[dict[str, Any]] = Field(default_factory=list, description="可选视觉锚点。")
    target_scene_count: int = Field(default=30, ge=1, le=80, description="目标语义场景数量。")
    min_scene_duration: float = Field(default=45.0, ge=1.0, description="最短语义场景时长。")
    max_scene_duration: float = Field(default=180.0, ge=1.0, description="最长语义场景时长。")


class SceneBoundaryContextPreviewResponse(BaseModel):
    """场景边界预览响应。"""

    scene_count: int
    shot_detection: dict[str, Any]
    scene_boundaries: list[dict[str, Any]]
    scene_boundary_context: str
