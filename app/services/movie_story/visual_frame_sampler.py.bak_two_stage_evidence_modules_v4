# -*- coding: utf-8 -*-
from __future__ import annotations

"""
visual_frame_sampler.py

What this module is:
- Deterministic keyframe sampling for movie_story visual evidence.

Why it exists:
- Vision-capable LLMs can understand frames well, but sending full videos or
  every shot frame is too expensive. This module samples a small number of
  timestamped frames from final highlights or other explicit time windows.

Input:
- video_path
- final_highlights or other time-window records with id/start/end
- output_dir for extracted frame files

Output:
- keyframe records with source_id, start, end, timestamp, frame_path, and reason.

Producer:
- visual_highlight_evidence
- future two-round narration input builders

Consumer:
- two_round_input_packager
- optional VLM visual relation checker

Formality:
- FORMAL INPUT BUILDER FOR TWO-ROUND NARRATION.

NOT FOR:
- selecting final highlights
- generating narration
- inferring character names
- inferring character psychology
- replacing VLM visual interpretation

Failure policy:
- Missing video_path, invalid timestamps, unreadable video, or failed frame read
  is a data/configuration error. Raise instead of silently returning empty
  visual evidence.
"""

from pathlib import Path
from typing import Any, Mapping, Sequence


__all__ = [
    "sample_times_for_window",
    "sample_frame_at_time",
    "sample_keyframes_for_windows",
    "sample_keyframes_for_highlights",
]


def sample_times_for_window(
    start: float,
    end: float,
    *,
    desired_count: int,
    max_count: int = 6,
) -> list[float]:
    """Return deterministic sampling timestamps inside one time window.

    Input:
    - start/end: window bounds in seconds.
    - desired_count: requested frame count.
    - max_count: hard cap used to control visual-model cost.

    Output:
    - A list of timestamps in seconds.

    NOT FOR:
    - deciding whether a window is a highlight.
    - reading video frames.
    - visual interpretation.
    """
    start_f = float(start)
    end_f = float(end)
    if end_f <= start_f:
        raise ValueError(f"invalid time window: start={start_f}, end={end_f}")
    if desired_count <= 0:
        raise ValueError(f"desired_count must be positive, got {desired_count}")
    if max_count <= 0:
        raise ValueError(f"max_count must be positive, got {max_count}")

    count = min(int(desired_count), int(max_count))
    duration = end_f - start_f

    if count == 1:
        fractions = [0.5]
    elif count == 2:
        fractions = [0.33, 0.67]
    elif count == 3:
        fractions = [0.2, 0.5, 0.8]
    else:
        fractions = [(index + 1) / (count + 1) for index in range(count)]

    return [round(start_f + duration * fraction, 3) for fraction in fractions]


def sample_frame_at_time(
    video_path: str | Path,
    timestamp_seconds: float,
    output_path: str | Path,
    *,
    max_edge: int = 960,
) -> Path:
    """Extract one frame from a video at a timestamp.

    Input:
    - video_path: readable source video file.
    - timestamp_seconds: timestamp in seconds.
    - output_path: destination image path.
    - max_edge: maximum image edge after resizing.

    Output:
    - The written frame path.

    Failure policy:
    - Missing cv2, unreadable video, or failed frame write raises RuntimeError.
    """
    try:
        import cv2  # type: ignore
    except Exception as exc:  # pragma: no cover
        raise RuntimeError("OpenCV/cv2 is required for frame extraction") from exc

    src = Path(video_path)
    if not src.exists():
        raise FileNotFoundError(src)

    timestamp = float(timestamp_seconds)
    if timestamp < 0:
        raise ValueError(f"timestamp_seconds must be non-negative, got {timestamp}")

    dst = Path(output_path)
    dst.parent.mkdir(parents=True, exist_ok=True)

    cap = cv2.VideoCapture(str(src))
    if not cap.isOpened():
        raise RuntimeError(f"failed to open video for frame extraction: {src}")

    try:
        cap.set(cv2.CAP_PROP_POS_MSEC, timestamp * 1000.0)
        ok, frame = cap.read()
    finally:
        cap.release()

    if not ok or frame is None:
        raise RuntimeError(f"failed to read frame at {timestamp:.3f}s from {src}")

    frame = _resize_keep_ratio(frame, max_edge=max_edge)
    written = cv2.imwrite(str(dst), frame)
    if not written:
        raise RuntimeError(f"failed to write keyframe: {dst}")
    return dst


def sample_keyframes_for_windows(
    video_path: str | Path,
    windows: Sequence[Mapping[str, Any]],
    output_dir: str | Path,
    *,
    desired_count: int = 3,
    max_frames_per_window: int = 6,
    id_fields: Sequence[str] = ("highlight_id", "candidate_id", "scene_id", "shot_id"),
) -> list[dict[str, Any]]:
    """Sample keyframes for explicit time windows.

    Input:
    - video_path: source video.
    - windows: records with id/start/end.
    - output_dir: image destination directory.
    - desired_count/max_frames_per_window: visual cost controls.
    - id_fields: explicit id priority. If none exists, raise.

    Output:
    - keyframe records aligned to source_id.

    NOT FOR:
    - selecting highlights.
    - generating scene_evidence.
    - interpreting frame contents.
    """
    if not windows:
        raise ValueError("windows must not be empty")

    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)

    records: list[dict[str, Any]] = []
    for window in windows:
        source_id = _resolve_window_id(window, id_fields=id_fields)
        start = _required_float(window, "start")
        end = _required_float(window, "end")
        times = sample_times_for_window(
            start,
            end,
            desired_count=desired_count,
            max_count=max_frames_per_window,
        )
        for index, timestamp in enumerate(times):
            safe_id = _safe_file_part(source_id)
            time_ms = int(round(timestamp * 1000))
            frame_path = out / f"{safe_id}_{index + 1:02d}_{time_ms:09d}.jpg"
            sample_frame_at_time(video_path, timestamp, frame_path)
            records.append(
                {
                    "source_id": source_id,
                    "source_type": _infer_source_type(window),
                    "start": start,
                    "end": end,
                    "timestamp": timestamp,
                    "frame_path": str(frame_path),
                    "reason": f"sample_{index + 1}_of_{len(times)}",
                }
            )
    return records


def sample_keyframes_for_highlights(
    video_path: str | Path,
    final_highlights: Sequence[Mapping[str, Any]],
    output_dir: str | Path,
    *,
    desired_count: int = 3,
    max_frames_per_highlight: int = 6,
) -> list[dict[str, Any]]:
    """Sample keyframes for formal final_highlights.

    Input:
    - final_highlights: records with highlight_id/start/end.

    Output:
    - keyframe records whose source_id equals highlight_id.

    Formality:
    - FORMAL INPUT BUILDER FOR TWO-ROUND NARRATION.

    NOT FOR:
    - runtime diagnostic shots.
    - story_audit windows.
    - native narration generation.
    """
    return sample_keyframes_for_windows(
        video_path,
        final_highlights,
        output_dir,
        desired_count=desired_count,
        max_frames_per_window=max_frames_per_highlight,
        id_fields=("highlight_id",),
    )


def _resize_keep_ratio(frame: Any, *, max_edge: int) -> Any:
    """Resize an OpenCV frame while preserving aspect ratio."""
    if max_edge <= 0:
        raise ValueError(f"max_edge must be positive, got {max_edge}")
    height, width = frame.shape[:2]
    longest = max(height, width)
    if longest <= max_edge:
        return frame

    try:
        import cv2  # type: ignore
    except Exception as exc:  # pragma: no cover
        raise RuntimeError("OpenCV/cv2 is required for frame resizing") from exc

    scale = max_edge / float(longest)
    new_size = (max(1, int(round(width * scale))), max(1, int(round(height * scale))))
    return cv2.resize(frame, new_size, interpolation=cv2.INTER_AREA)


def _resolve_window_id(window: Mapping[str, Any], *, id_fields: Sequence[str]) -> str:
    """Resolve a stable id from explicit allowed fields; raise if absent."""
    for field in id_fields:
        value = str(window.get(field) or "").strip()
        if value:
            return value
    raise KeyError(f"window is missing required id field; tried {list(id_fields)}")


def _required_float(window: Mapping[str, Any], key: str) -> float:
    """Read a required numeric field from a time-window record."""
    if key not in window:
        raise KeyError(f"window is missing required key: {key}")
    value = window[key]
    if value in (None, ""):
        raise ValueError(f"window key {key!r} is empty")
    return float(value)


def _infer_source_type(window: Mapping[str, Any]) -> str:
    """Infer source type from explicit id fields for audit readability."""
    if window.get("highlight_id"):
        return "final_highlight"
    if window.get("shot_id"):
        return "shot"
    if window.get("scene_id"):
        return "scene"
    if window.get("candidate_id"):
        return "candidate"
    return "time_window"


def _safe_file_part(value: str) -> str:
    """Create a filename-safe id segment without path traversal."""
    safe = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in str(value))
    safe = safe.strip("._-")
    if not safe:
        raise ValueError(f"invalid file-safe id from value: {value!r}")
    return safe[:80]
