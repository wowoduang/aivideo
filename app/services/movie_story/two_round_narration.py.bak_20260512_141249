from __future__ import annotations

import json
import os
import re
from pathlib import Path
from typing import Any, Callable

ANALYSIS_PROMPT_TEMPLATE = '以下是一集电视剧的SRT字幕，我需要你做分析，不写任何文案句子。\n\n影视名称：{title}\n本集信息：{episode_info}\n史观视角：{history_view}\n\n步骤一，建立剧情底图。\n\n用你对这部剧的已有认知，列出本集主要角色、人物关系、本集核心事件。不确定的标注"存疑"，不要强行填写。\n\n步骤二，提取结构性事实。\n\n对照剧情底图读完全部字幕，找出这集里最反常识的3到5个结构性事实。\n\n结构性事实的定义：不是剧情事件，而是这个事件背后可以被概括的、跨越时代依然成立的规律。不是"税吏向朱五四催税"，而是"一个正常运转的征税系统，其欠款计算方式本身就能制造出任何人都还不清的债务"。\n\n每个结构性事实输出三项：原片时间范围、事实本身（一句话，脱离这部剧依然成立）、对应的字幕证据（一句台词或动作描述，不展开）。\n\n步骤三，提出主线候选。\n\n基于步骤二的结构性事实，在所选史观视角下，提出2到3条可能的文案主线。\n\n每条主线输出两项：主论点（一句话，这是整篇文案要说服读者相信的核心判断）、分论点序列（3到4个分论点，必须有递进关系，不能是并列，每个分论点对应步骤二里的一个结构性事实）。\n\n完成后停下，不写文案，等待我选择主线。\n\n字幕内容如下：\n\n{raw_srt_text}\n'

WRITER_PROMPT_TEMPLATE = '以下是对一集电视剧的分析结果，请基于这份分析写文案。字幕原文不会出现在这里，你只能用分析结果里提炼出的结构性事实来写。\n\n{analysis_result}\n\n我选择的主线是：{selected_mainline}\n\n现在按以下要求写文案。\n\n写之前先做一件事：把主论点拆成3到4个分论点，每个分论点是主论点的一个递进维度，不是并列关系。分论点之间的逻辑是"不仅如此，更进一步"，而不是"另外还有"。把分论点序列写出来，再开始写文案。\n\n分论点序列不要标注时间，不要写成文案。\n\n正式文案从【正式文案】开始。\n正式文案每一段必须使用如下格式：\n\n[MM:SS ~ MM:SS]\n文案正文。\n\n文案结构如下。\n\n开场：主论点本身或其最锋利的变体，一句话，直接成立，不铺垫。注明取材范围。\n\n分论点一到三或四，每个分论点写一段：用分析结果里对应的结构性事实来支撑，每段2到4句，每句15到30字。\n\n写之前先问自己：这句话是在解释那个结构性事实，还是在重复它？重复就重写。这个判断不依赖任何台词，不知道这部剧的人读了也能懂。注明取材范围。\n\n当下回响：把文案里的某个结构性事实，和今天某个具体的制度现实并排放，不加任何连接词，不点破。注明取材范围。\n\n收尾：把主论点推进一步，不是重复，是升维。用反问或留白，不做总结式升华。注明取材范围。\n\n对比示例校准洞察深度。\n\n解读式是"这不是欠债，是系统性的绞杀"，还在对着原始事实，只换了说法。\n\n创作型是"账本能活过王朝，人活不过一季庄稼"，离开了原始事实，说的是它背后的结构规律。\n\n每写完一段用这个标准过一遍，没过就重写。\n'

RAW_SRT_MARKERS = (
    "【原版 SRT 字幕】",
    "【原始 SRT 字幕】",
    "【原始SRT文本】",
    "【带时间戳的原版字幕】",
    "字幕内容如下：",
)


def debug_dir() -> Path:
    path = Path("storage") / "temp" / "raw_srt_debug"
    path.mkdir(parents=True, exist_ok=True)
    return path


def write_debug(name: str, text: Any) -> None:
    try:
        (debug_dir() / name).write_text(str(text or ""), encoding="utf-8")
    except Exception:
        pass


def response_to_text(response: Any) -> str:
    if response is None:
        return ""
    if isinstance(response, str):
        return response
    if isinstance(response, bytes):
        return response.decode("utf-8", errors="ignore")
    if isinstance(response, dict):
        try:
            choices = response.get("choices")
            if choices:
                message = choices[0].get("message") or {}
                content = message.get("content")
                if content:
                    return str(content)
        except Exception:
            pass
        for key in ("text", "content", "message", "response", "result"):
            value = response.get(key)
            if isinstance(value, str):
                return value
        return json.dumps(response, ensure_ascii=False)
    return str(response)


def extract_raw_srt(full_prompt: str) -> str:
    text = str(full_prompt or "")
    best_index = -1
    best_marker = ""
    for marker in RAW_SRT_MARKERS:
        index = text.rfind(marker)
        if index > best_index:
            best_index = index
            best_marker = marker
    if best_index >= 0:
        return text[best_index + len(best_marker):].strip()
    return text.strip()


def env_text(name: str, default: str) -> str:
    value = os.getenv(name)
    return value.strip() if value and value.strip() else default


def build_analysis_prompt(raw_srt_text: str) -> str:
    return ANALYSIS_PROMPT_TEMPLATE.format(
        title=env_text("MOVIE_STORY_TITLE", "未知剧名"),
        episode_info=env_text("MOVIE_STORY_EPISODE_INFO", "本集剧情由字幕判断"),
        history_view=env_text("MOVIE_STORY_HISTORY_VIEW", "阶层结构、失败者史观、权力结构"),
        raw_srt_text=raw_srt_text,
    )


def build_writer_prompt(analysis_result: str) -> str:
    selected_mainline = env_text(
        "MOVIE_STORY_SELECTED_MAINLINE",
        "请从分析结果中的主线候选里，自动选择最有解释力、最适合成片的一条主线。",
    )
    return WRITER_PROMPT_TEMPLATE.format(
        analysis_result=analysis_result,
        selected_mainline=selected_mainline,
    )


def extract_formal_script(writer_text: str) -> str:
    text = str(writer_text or "").strip()
    marker = "【正式文案】"
    index = text.find(marker)
    if index >= 0:
        text = text[index + len(marker):].strip()
    match = re.search(r"正式文案[：:]\s*", text)
    if match:
        text = text[match.end():].strip()
    return text


def run_two_round_narration_from_prompt(
    full_prompt: str,
    call_llm: Callable[[str], Any],
) -> str:
    if os.getenv("MOVIE_STORY_TWO_ROUND_DISABLE", "").lower() in {"1", "true", "yes", "on"}:
        return response_to_text(call_llm(full_prompt))

    raw_srt_text = extract_raw_srt(full_prompt)
    write_debug("last_original_single_prompt.txt", full_prompt)

    analysis_prompt = build_analysis_prompt(raw_srt_text)
    write_debug("last_analysis_prompt.txt", analysis_prompt)
    analysis_text = response_to_text(call_llm(analysis_prompt))
    write_debug("last_analysis_response.txt", analysis_text)

    writer_prompt = build_writer_prompt(analysis_text)
    write_debug("last_writer_prompt.txt", writer_prompt)
    writer_text = response_to_text(call_llm(writer_prompt))
    write_debug("last_writer_response.txt", writer_text)

    final_script = extract_formal_script(writer_text)
    write_debug("last_two_round_final_script.txt", final_script)
    return final_script
