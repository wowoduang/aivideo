from collections.abc import Mapping, Sequence
from typing import Any

from app.services.movie_story.scene_boundary_source import build_scene_boundary_context_from_video


def build_scene_boundary_context_preview_payload(request: Mapping[str, Any]) -> dict[str, Any]:
    """
    构建 scene_boundary_context 预览 payload。

    request 格式：
    {
      "video_path": "...",
      "subtitle_segments": [{"start": 0, "end": 3, "text": "..."}],
      "visual_anchors": [],
      "target_scene_count": 30,
      "min_scene_duration": 45,
      "max_scene_duration": 180
    }
    """
    video_path = require_non_empty_string(request, "video_path")
    subtitle_segments = require_non_empty_sequence(request, "subtitle_segments")
    visual_anchors = optional_sequence(request, "visual_anchors")

    target_scene_count = optional_int(
        request,
        "target_scene_count",
        default=30,
        minimum=1,
        maximum=80,
    )
    min_scene_duration = optional_float(
        request,
        "min_scene_duration",
        default=45.0,
        minimum=1.0,
    )
    max_scene_duration = optional_float(
        request,
        "max_scene_duration",
        default=180.0,
        minimum=1.0,
    )
    if max_scene_duration < min_scene_duration:
        raise ValueError(
            f"max_scene_duration 必须大于等于 min_scene_duration: "
            f"{max_scene_duration} < {min_scene_duration}"
        )

    payload = build_scene_boundary_context_from_video(
        video_path=video_path,
        subtitle_segments=subtitle_segments,
        visual_anchors=visual_anchors,
        target_scene_count=target_scene_count,
        min_scene_duration=min_scene_duration,
        max_scene_duration=max_scene_duration,
    )

    context = str(payload.get("scene_boundary_context") or "").strip()
    if not context:
        raise RuntimeError("scene_boundary_context 为空；新链路不静默返回空结果。")

    return {
        "scene_count": int(payload.get("scene_count") or 0),
        "shot_detection": payload.get("shot_detection") or {},
        "scene_boundaries": payload.get("scene_boundaries") or [],
        "scene_boundary_context": context,
    }


def require_non_empty_string(request: Mapping[str, Any], key: str) -> str:
    """读取非空字符串。"""
    value = request.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"缺少必填字符串字段: {key}")
    return value.strip()


def require_non_empty_sequence(request: Mapping[str, Any], key: str) -> Sequence[Mapping[str, Any]]:
    """读取非空 sequence。"""
    value = request.get(key)
    if not isinstance(value, Sequence) or isinstance(value, (str, bytes)) or not value:
        raise ValueError(f"缺少必填数组字段: {key}")
    for index, item in enumerate(value):
        if not isinstance(item, Mapping):
            raise ValueError(f"{key}[{index}] 必须是对象")
    return value  # type: ignore[return-value]


def optional_sequence(request: Mapping[str, Any], key: str) -> Sequence[Mapping[str, Any]]:
    """读取可选 sequence。"""
    value = request.get(key)
    if value is None:
        return []
    if not isinstance(value, Sequence) or isinstance(value, (str, bytes)):
        raise ValueError(f"{key} 必须是数组")
    for index, item in enumerate(value):
        if not isinstance(item, Mapping):
            raise ValueError(f"{key}[{index}] 必须是对象")
    return value  # type: ignore[return-value]


def optional_int(
    request: Mapping[str, Any],
    key: str,
    *,
    default: int,
    minimum: int,
    maximum: int,
) -> int:
    """读取可选 int。"""
    value = request.get(key, default)
    try:
        result = int(value)
    except (TypeError, ValueError):
        raise ValueError(f"{key} 必须是整数") from None
    if result < minimum or result > maximum:
        raise ValueError(f"{key} 超出范围: {result}, 允许范围 {minimum}~{maximum}")
    return result


def optional_float(
    request: Mapping[str, Any],
    key: str,
    *,
    default: float,
    minimum: float,
) -> float:
    """读取可选 float。"""
    value = request.get(key, default)
    try:
        result = float(value)
    except (TypeError, ValueError):
        raise ValueError(f"{key} 必须是数字") from None
    if result < minimum:
        raise ValueError(f"{key} 不能小于 {minimum}: {result}")
    return result
