from __future__ import annotations

import json
import os
import re
from pathlib import Path
from typing import Any, Callable

ANALYSIS_PROMPT_TEMPLATE = '以下是一集电视剧的SRT字幕，我需要你做结构分析。不要输出【正式文案】正文。\n\n影视名称：{title}\n本集信息：{episode_info}\n史观视角：{history_view}\n\n你的任务不是复述字幕，而是从整集字幕里建立结构理解，为第二轮主线解说提供材料。\n\n步骤一，建立剧情底图。\n用你对这部剧的已有认知，列出本集主要角色、人物关系、本集核心事件。不确定的标注"存疑"，不要强行填写。\n\n步骤二，提取结构性事实。\n对照剧情底图读完全部字幕，找出这集里最反常识的3到6个结构性事实。\n结构性事实不是剧情事件，而是事件背后跨越时代依然成立的规律。\n不是"税吏向朱五四催税"，而是"一个正常运转的征税系统，其欠款计算方式本身就能制造出任何人都还不清的债务"。\n\n每个结构性事实必须输出四项：\n1. 原片时间范围：必须是可用于剪辑的具体短范围，优先 15 到 120 秒，最长不要超过 180 秒。\n2. 事实本身：一句话，脱离这部剧依然成立。\n3. 字幕证据：一句台词或动作描述，不展开。\n4. 画面作用：说明这一时间范围为什么适合后续切原片。\n\n步骤三，提出主线候选。\n基于步骤二的结构性事实，在所选史观视角下，提出2到4条可能的文案主线。\n每条主线输出三项：\n1. 主论点：一句话，这是整篇文案要说服观众相信的核心判断。\n2. 分论点序列：3到6个递进分论点，必须是"不仅如此，更进一步"，不能是并列罗列。\n3. 对应结构性事实编号：标明每个分论点使用哪几个结构性事实。\n\n步骤四，自动推荐主线。\n不要等待用户选择。请你从候选里自动推荐1到3条最适合短视频成片的主线，并说明推荐理由。默认优先1到2条，素材复杂时允许第3条作为辅助线。\n\n输出要求：\n1. 只输出结构分析，不输出【正式文案】。\n2. 不要按字幕顺序逐段总结。\n3. 不要把对白改写成旁白。\n4. 时间范围必须是后续可以切原片的具体片段，不要给整集或半集大跨度。\n5. 不要出现"收到指令"、"我将遵循"、"我不会写文案"之类自我声明。\n\n字幕内容如下：\n\n{raw_srt_text}\n'

WRITER_PROMPT_TEMPLATE = '以下是第一轮对电视剧字幕的结构分析结果。请基于这份分析写正式解说文案。\n字幕原文不会出现在这里，你只能使用分析结果里的结构性事实、主线候选和原片时间范围。\n\n【第一轮分析结果】\n{analysis_result}\n\n【主线选择要求】\n{selected_mainline}\n\n现在按以下要求写文案。\n\n总原则：\n1. 你必须围绕1到3条主旨/主线写；默认优先1到2条，素材复杂时允许第3条作为辅助线，不是按字幕顺序复述。\n2. 可以保留“开场、分论点、当下回响、收尾”的结构，因为这是成片表达结构。\n3. 每一段都必须带 [MM:SS ~ MM:SS]，这个时间码是后续切原片的依据。\n4. 每段时间码必须来自第一轮结构性事实里的具体原片时间范围，或其更小的范围。\n5. 每段时间码必须是可剪辑短片段，优先 15 到 120 秒，最长不要超过 180 秒。\n6. 收尾和当下回响也必须绑定一个具体短片段；严禁使用整集跨度、半集跨度或多个结构性事实拼成的大跨度。\n7. 如果某段是在总结全片主题，文案可以总结全片，但时间码仍然只能选择最能代表这句话的一个具体原片片段。\n8. 不要写“他说、她说、随后、接着”这种剧情流水账。\n9. 不要逐句复述字幕，不要把对白改写成旁白。\n10. 每一句都要解释结构性事实背后的规律，而不是重复结构性事实本身。\n\n写之前先做一件事：\n从第一轮候选中自动选择1到3条最适合成片的主线，并把主论点拆成3到6个递进分论点。默认优先1到2条主线；只有素材复杂、两条主线不足以解释本集时，才使用第3条辅助线。\n分论点之间的逻辑是“不是只有A，更进一步是B，最后指向C”，不能是“另外还有”。\n分论点序列不要标注时间，不要写成文案。\n\n正式文案从【正式文案】开始。\n正式文案每一段必须使用如下格式：\n\n**开场**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**分论点一**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**分论点二**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**分论点三**\n[MM:SS ~ MM:SS]\n文案正文。\n\n如果第一轮结构性事实足够支撑，可以继续输出：\n\n**分论点四**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**分论点五**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**分论点六**\n[MM:SS ~ MM:SS]\n文案正文。\n\n然后继续输出：\n\n**当下回响**\n[MM:SS ~ MM:SS]\n文案正文。\n\n**收尾**\n[MM:SS ~ MM:SS]\n文案正文。\n\n文案结构说明：\n开场：主论点本身或其最锋利的变体，一句话，直接成立，不铺垫。\n分论点一到三、四、五或六：每段使用一个结构性事实支撑主线推进，每段2到6句，每句15到45字；允许围绕本集主论点写得更丰富、更深刻，但不能灌水。\n当下回响：把文案里的某个结构性事实，和今天某个具体的制度现实并排放，不空泛说教。\n收尾：把主论点推进一步，不是重复，是升维。用反问或留白，不做总结式升华。\n\n字数软约束：\n正式文案总字数建议控制在700到1300字；如果使用5到6个结构性事实，最多可以到1500字。优先保证主论点清晰和分论点深度，不要为了凑字数复述字幕。\n\n时间码检查：\n写完每一段后检查：这段时间码是不是一个能直接切原片的具体片段？\n如果它跨越了多个结构性事实，或者跨度超过180秒，必须改成其中最能代表这段文案的短片段。\n\n深度校准：\n解读式是“这不是欠债，是系统性的绞杀”，还在对着原始事实，只换了说法。\n创作型是“账本能活过王朝，人活不过一季庄稼”，离开了原始事实，说的是它背后的结构规律。\n每写完一段用这个标准过一遍，没过就重写。\n\n严禁：\n1. 严禁输出“我将严格遵循”“我不会写文案”等自我声明。\n2. 严禁把第一轮里“不要写文案”的分析任务说明带入第二轮。\n3. 严禁使用 00:00 ~ 43:00、00:07:44 ~ 00:43:24 这种整集/半集大跨度作为某一段时间码。\n4. 严禁没有时间码的段落。\n'

RAW_SRT_MARKERS = (
    "【原版 SRT 字幕】",
    "【原始 SRT 字幕】",
    "【原始SRT文本】",
    "【带时间戳的原版字幕】",
    "字幕内容如下：",
)

def debug_dir() -> Path:
    path = Path("storage") / "temp" / "raw_srt_debug"
    path.mkdir(parents=True, exist_ok=True)
    return path


def write_debug(name: str, text: Any) -> None:
    try:
        (debug_dir() / name).write_text(str(text or ""), encoding="utf-8")
    except Exception:
        pass


def response_to_text(response: Any) -> str:
    if response is None:
        return ""
    if isinstance(response, str):
        return response
    if isinstance(response, bytes):
        return response.decode("utf-8", errors="ignore")
    if isinstance(response, dict):
        try:
            choices = response.get("choices")
            if choices:
                message = choices[0].get("message") or {}
                content = message.get("content")
                if content:
                    return str(content)
        except Exception:
            pass
        for key in ("text", "content", "message", "response", "result"):
            value = response.get(key)
            if isinstance(value, str):
                return value
        return json.dumps(response, ensure_ascii=False)
    return str(response)


def extract_raw_srt(full_prompt: str) -> str:
    text = str(full_prompt or "")
    best_index = -1
    best_marker = ""
    for marker in RAW_SRT_MARKERS:
        index = text.rfind(marker)
        if index > best_index:
            best_index = index
            best_marker = marker
    if best_index >= 0:
        return text[best_index + len(best_marker):].strip()
    return text.strip()


def env_text(name: str, default: str) -> str:
    value = os.getenv(name)
    return value.strip() if value and value.strip() else default


def build_analysis_prompt(raw_srt_text: str) -> str:
    return ANALYSIS_PROMPT_TEMPLATE.format(
        title=env_text("MOVIE_STORY_TITLE", "未知剧名"),
        episode_info=env_text("MOVIE_STORY_EPISODE_INFO", "本集剧情由字幕判断"),
        history_view=env_text("MOVIE_STORY_HISTORY_VIEW", "阶层结构、失败者史观、权力结构"),
        raw_srt_text=raw_srt_text,
    )


def sanitize_analysis_result(analysis_result: str) -> str:
    """避免第一轮的任务声明/免责声明污染第二轮写作。"""
    raw = str(analysis_result or "").replace("\r\n", "\n").replace("\r", "\n")
    cleaned_lines = []
    for line in raw.split("\n"):
        s = line.strip()
        if not s:
            cleaned_lines.append("")
            continue
        bad_phrases = (
            "收到指令",
            "严格遵循",
            "不撰写任何文案",
            "不写任何文案",
            "不会写文案",
            "等待我选择",
            "完成后停下",
        )
        if any(phrase in s for phrase in bad_phrases):
            continue
        cleaned_lines.append(line)
    out = "\n".join(cleaned_lines)
    out = re.sub(r"\n{3,}", "\n\n", out).strip()
    return out


def build_writer_prompt(analysis_result: str) -> str:
    selected_mainline = env_text(
        "MOVIE_STORY_SELECTED_MAINLINE",
        "请从分析结果中的主线候选里，自动选择1到3条最有解释力、最适合成片的主线；默认优先1到2条，素材复杂时允许第3条作为辅助线。",
    )
    return WRITER_PROMPT_TEMPLATE.format(
        analysis_result=sanitize_analysis_result(analysis_result),
        selected_mainline=selected_mainline,
    )
def extract_formal_script(writer_text: str) -> str:
    text = str(writer_text or "").strip()
    marker = "【正式文案】"
    index = text.find(marker)
    if index >= 0:
        text = text[index + len(marker):].strip()
    match = re.search(r"正式文案[：:]\s*", text)
    if match:
        text = text[match.end():].strip()

    # 保留“开场/分论点/当下回响/收尾”和时间码，但清掉第二轮可能残留的自我声明。
    lines = []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        s = line.strip()
        if s and (
            "收到指令" in s
            or "严格遵循" in s
            or "不撰写任何文案" in s
            or "不会写文案" in s
            or "不写任何文案" in s
        ):
            continue
        lines.append(line)
    return re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
def run_two_round_narration_from_prompt(
    full_prompt: str,
    call_llm: Callable[[str], Any],
) -> str:
    if os.getenv("MOVIE_STORY_TWO_ROUND_DISABLE", "").lower() in {"1", "true", "yes", "on"}:
        return response_to_text(call_llm(full_prompt))

    raw_srt_text = extract_raw_srt(full_prompt)
    write_debug("last_original_single_prompt.txt", full_prompt)

    analysis_prompt = build_analysis_prompt(raw_srt_text)
    write_debug("last_analysis_prompt.txt", analysis_prompt)
    analysis_text = response_to_text(call_llm(analysis_prompt))
    write_debug("last_analysis_response.txt", analysis_text)

    writer_prompt = build_writer_prompt(analysis_text)
    write_debug("last_writer_prompt.txt", writer_prompt)
    writer_text = response_to_text(call_llm(writer_prompt))
    write_debug("last_writer_response.txt", writer_text)

    final_script = extract_formal_script(writer_text)
    write_debug("last_two_round_final_script.txt", final_script)
    return final_script
