# -*- coding: utf-8 -*-
from __future__ import annotations

"""
scene_boundary_context_api_adapter.py

scene_boundary_context API 层适配器。

职责：
- 校验前端/路由传入的 video_path、subtitle_segments 和参数。
- 复用项目既有 scene_builder.build_scenes 作为唯一场景切分来源。
- 调用 scene_boundary_context_formatter 把旧 scene 时间轴格式化为 prompt context。

禁止：
- 不新增第二套场景切分算法。
- 不新增 fallback。
- 不静默返回空 scene_boundary_context。
- 不调用 LLM。
"""

from collections.abc import Mapping, Sequence
from pathlib import Path
from typing import Any

from app.services.scene_builder import build_scenes
from app.services.movie_story.scene_boundary_context_formatter import (
    build_scene_boundary_context_payload_from_scenes,
    normalize_subtitle_segments,
)


def build_scene_boundary_context_preview_payload(request: Mapping[str, Any]) -> dict[str, Any]:
    """构建 scene_boundary_context 预览 payload。"""
    video_path = require_non_empty_string(request, "video_path")
    if not Path(video_path).exists():
        raise FileNotFoundError(f"视频文件不存在，无法生成场景边界: {video_path}")

    subtitle_segments = normalize_subtitle_segments(require_non_empty_sequence(request, "subtitle_segments"))

    max_scene_count = optional_int(
        request,
        "target_scene_count",
        default=30,
        minimum=1,
        maximum=300,
    )
    min_scene_duration = optional_float(
        request,
        "min_scene_duration",
        default=1.5,
        minimum=0.1,
    )
    max_scene_duration = optional_float(
        request,
        "max_scene_duration",
        default=12.0,
        minimum=0.1,
    )
    if max_scene_duration < min_scene_duration:
        raise ValueError(
            f"max_scene_duration 必须大于等于 min_scene_duration: "
            f"{max_scene_duration} < {min_scene_duration}"
        )

    scene_segments = build_scenes(
        subtitle_segments=subtitle_segments,
        video_path=video_path,
        mode="balanced",
        max_scene_duration=max_scene_duration,
        min_scene_duration=min_scene_duration,
    )
    if not scene_segments:
        raise RuntimeError("scene_builder.build_scenes 未返回任何场景片段")

    payload = build_scene_boundary_context_payload_from_scenes(
        scene_segments=scene_segments,
        subtitle_segments=subtitle_segments,
        max_scene_count=max_scene_count,
    )

    context = str(payload.get("scene_boundary_context") or "").strip()
    if not context:
        raise RuntimeError("scene_boundary_context 为空；新链路不静默返回空结果。")

    return {
        "scene_count": int(payload.get("scene_count") or 0),
        "scene_source": payload.get("scene_source") or {},
        "scene_boundaries": payload.get("scene_boundaries") or [],
        "scene_boundary_context": context,
    }


def require_non_empty_string(request: Mapping[str, Any], key: str) -> str:
    """读取非空字符串。"""
    value = request.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"缺少必填字符串字段: {key}")
    return value.strip()


def require_non_empty_sequence(request: Mapping[str, Any], key: str) -> Sequence[Mapping[str, Any]]:
    """读取非空 sequence。"""
    value = request.get(key)
    if not isinstance(value, Sequence) or isinstance(value, (str, bytes)) or not value:
        raise ValueError(f"缺少必填数组字段: {key}")
    for index, item in enumerate(value):
        if not isinstance(item, Mapping):
            raise ValueError(f"{key}[{index}] 必须是对象")
    return value  # type: ignore[return-value]


def optional_int(
    request: Mapping[str, Any],
    key: str,
    *,
    default: int,
    minimum: int,
    maximum: int,
) -> int:
    """读取可选 int。"""
    value = request.get(key, default)
    try:
        result = int(value)
    except (TypeError, ValueError):
        raise ValueError(f"{key} 必须是整数") from None
    if result < minimum or result > maximum:
        raise ValueError(f"{key} 超出范围: {result}, 允许范围 {minimum}~{maximum}")
    return result


def optional_float(
    request: Mapping[str, Any],
    key: str,
    *,
    default: float,
    minimum: float,
) -> float:
    """读取可选 float。"""
    value = request.get(key, default)
    try:
        result = float(value)
    except (TypeError, ValueError):
        raise ValueError(f"{key} 必须是数字") from None
    if result < minimum:
        raise ValueError(f"{key} 不能小于 {minimum}: {result}")
    return result
