from __future__ import annotations

import json
import os
import re
from pathlib import Path
from typing import Any, Callable

ANALYSIS_PROMPT_TEMPLATE = '以下是一集电视剧的SRT字幕，我需要你做结构分析。不要输出【正式文案】正文。\n\n影视名称：未知剧名\n本集信息：本集剧情由字幕判断\n史观视角：阶层结构、失败者史观、权力结构\n\n你的任务不是复述字幕，而是从整集字幕里建立结构理解，为第二轮主线解说提供材料。\n\n步骤一，建立剧情底图。\n用你对这部剧的已有认知，列出本集主要角色、人物关系、本集核心事件。不确定的标注"存疑"，不要强行填写。\n\n步骤二，提取结构性事实。\n对照剧情底图读完全部字幕，找出这集里最反常识的3到6个结构性事实。\n结构性事实不是剧情事件，而是这个事件背后可以被概括的、跨越时代依然成立的规律。\n\n每个结构性事实必须输出四项：\n1. 原片时间范围：必须是可用于剪辑的具体短范围，必须 30 到 120 秒，最长不要超过 180 秒。\n2. 事实本身：一句话，脱离这部剧依然成立。\n3. 对应字幕证据：一句台词或动作描述，不展开。\n4. 画面作用：说明这一时间范围为什么适合后续切原片。\n\n步骤三，提出主线候选。\n基于步骤二的结构性事实，在所选史观视角下，提出2到3条可能的文案主线。\n每条主线输出三项：\n1. 主论点：一句话，这是整篇文案要说服观众相信的核心判断。\n2. 分论点序列：3到6个递进分论点，必须是"不仅如此，更进一步"，不能是并列罗列。\n3. 对应结构性事实编号：标明每个分论点使用哪几个结构性事实。\n\n步骤四，自动推荐主线。\n不要等待用户选择。请你从候选里自动推荐1到3条最适合短视频成片的主线，并说明推荐理由。默认优先1到2条，素材复杂时允许第3条作为辅助线。\n\n输出要求：\n1. 只输出结构分析，不输出【正式文案】。\n2. 不要按字幕顺序逐段总结。\n3. 不要把对白改写成旁白。\n4. 时间范围必须是后续可以切原片的具体片段，不要给整集或半集大跨度。\n5. 不要出现"收到指令"、"我将遵循"、"我不会写文案"之类自我声明。\n\n字幕内容如下：\n{raw_srt_text}\n'

WRITER_PROMPT_TEMPLATE = '以下是第一轮结构分析结果：\n{analysis_result}\n\n请从以上分析结果中的主线候选里，自动选择1条最有解释力、最适合成片的主线写文案。字幕原文不会出现在这里，你只能用分析结果里提炼出的结构性事实来写。\n\n现在按以下要求写文案：\n\n1. 把主论点拆成3到6个分论点，每个分论点是主论点的一个递进维度，不是并列关系。分论点之间的逻辑是"不仅如此，更进一步"，而不是"另外还有"。\n\n2. 可以保留"开场、分论点、回响、收尾"的结构，因为这是成片表达结构。\n\n3. 开场：主论点本身或其最锋利的变体，一句话，直接成立，不铺垫。\n\n4. 分论点一到六，根据主论点和结构性事实灵活决定数量，每个分论点写一段：用分析结果里对应的结构性事实来支撑。\n\n5. 回响：把文案里的某个结构性事实，和当时某个具体的制度现实并排放，不加任何连接词，不点破。\n\n6. 收尾：把主论点推进一步，不是重复，是升维。用反问或留白，不做总结式升华。\n\n7. 每一段都必须带 [MM:SS ~ MM:SS]，这个时间码是后续切原片的依据。\n\n8. 每段时间码必须来自第一轮结构性事实里的具体原片时间范围，或在该范围前后适度扩展后的范围。\n\n9. 时间码倒推规则（每段必须执行，不可跳过）：\n   写完每段文案正文后，先数这段文案的字数，除以5，得到最短所需画面秒数。\n   时间码跨度 = MAX（最短所需画面秒数，30秒）。\n   如果从第一轮结构性事实继承的时间码跨度不满足这个下限，则向前或向后扩展原片范围，直到满足为止。\n   在每段时间码后面用括号标注计算过程，格式为：（本段N字，朗读约需M秒，时间码跨度不低于MAX(M,30)秒=P秒，实际给出Q秒）。\n\n10. 如果某段是在总结全片主题，文案可以总结全片，但时间码仍然只能选择最能代表这句话的一个具体原片片段。\n\n11. 分论点时间码尽量按原片时间递增；如果递进逻辑和原片时间冲突，优先保证主线表达，不要为了时间顺序写成流水账。\n\n12. 不要写"他说、她说、随后、接着"这种剧情流水账。\n\n13. 不要逐句复述字幕，不要把对白改写成旁白。\n\n14. 不要输出"收到指令""我将遵循""我不会写文案"等自我声明。\n\n正式文案格式：\n\n**开场**\n[MM:SS ~ MM:SS]（本段N字，朗读约需M秒，时间码跨度不低于P秒，实际给出Q秒）\n文案正文。\n\n**分论点一**\n[MM:SS ~ MM:SS]（本段N字，朗读约需M秒，时间码跨度不低于P秒，实际给出Q秒）\n文案正文。\n\n**分论点二**\n[MM:SS ~ MM:SS]（本段N字，朗读约需M秒，时间码跨度不低于P秒，实际给出Q秒）\n文案正文。\n\n如果结构性事实足够支撑，可以继续输出 **分论点三** 到 **分论点六**。\n\n**回响**\n[MM:SS ~ MM:SS]（本段N字，朗读约需M秒，时间码跨度不低于P秒，实际给出Q秒）\n文案正文。\n\n**收尾**\n[MM:SS ~ MM:SS]（本段N字，朗读约需M秒，时间码跨度不低于P秒，实际给出Q秒）\n文案正文。\n'

RAW_SRT_MARKERS = (
    "【原版 SRT 字幕】",
    "【原始 SRT 字幕】",
    "【原始SRT文本】",
    "【带时间戳的原版字幕】",
    "字幕内容如下：",
)

def debug_dir() -> Path:
    path = Path("storage") / "temp" / "raw_srt_debug"
    path.mkdir(parents=True, exist_ok=True)
    return path


def write_debug(name: str, text: Any) -> None:
    try:
        (debug_dir() / name).write_text(str(text or ""), encoding="utf-8")
    except Exception:
        pass


def response_to_text(response: Any) -> str:
    if response is None:
        return ""
    if isinstance(response, str):
        return response
    if isinstance(response, bytes):
        return response.decode("utf-8", errors="ignore")
    if isinstance(response, dict):
        try:
            choices = response.get("choices")
            if choices:
                message = choices[0].get("message") or {}
                content = message.get("content")
                if content:
                    return str(content)
        except Exception:
            pass
        for key in ("text", "content", "message", "response", "result"):
            value = response.get(key)
            if isinstance(value, str):
                return value
        return json.dumps(response, ensure_ascii=False)
    return str(response)


def extract_raw_srt(full_prompt: str) -> str:
    text = str(full_prompt or "")
    best_index = -1
    best_marker = ""
    for marker in RAW_SRT_MARKERS:
        index = text.rfind(marker)
        if index > best_index:
            best_index = index
            best_marker = marker
    if best_index >= 0:
        return text[best_index + len(best_marker):].strip()
    return text.strip()


def env_text(name: str, default: str) -> str:
    value = os.getenv(name)
    return value.strip() if value and value.strip() else default


def build_analysis_prompt(raw_srt_text: str) -> str:
    return ANALYSIS_PROMPT_TEMPLATE.format(
        title=env_text("MOVIE_STORY_TITLE", "未知剧名"),
        episode_info=env_text("MOVIE_STORY_EPISODE_INFO", "本集剧情由字幕判断"),
        history_view=env_text("MOVIE_STORY_HISTORY_VIEW", "阶层结构、失败者史观、权力结构"),
        raw_srt_text=raw_srt_text,
    )


def sanitize_analysis_result(analysis_result: str) -> str:
    """避免第一轮的任务声明/免责声明污染第二轮写作。"""
    raw = str(analysis_result or "").replace("\r\n", "\n").replace("\r", "\n")
    cleaned_lines = []
    for line in raw.split("\n"):
        s = line.strip()
        if not s:
            cleaned_lines.append("")
            continue
        bad_phrases = (
            "收到指令",
            "严格遵循",
            "不撰写任何文案",
            "不写任何文案",
            "不会写文案",
            "等待我选择",
            "完成后停下",
        )
        if any(phrase in s for phrase in bad_phrases):
            continue
        cleaned_lines.append(line)
    out = "\n".join(cleaned_lines)
    out = re.sub(r"\n{3,}", "\n\n", out).strip()
    return out


def build_writer_prompt(analysis_result: str) -> str:
    selected_mainline = env_text(
        "MOVIE_STORY_SELECTED_MAINLINE",
        "请从分析结果中的主线候选里，自动选择1到3条最有解释力、最适合成片的主线；默认优先1到2条，素材复杂时允许第3条作为辅助线。",
    )
    return WRITER_PROMPT_TEMPLATE.format(
        analysis_result=sanitize_analysis_result(analysis_result),
        selected_mainline=selected_mainline,
    )
def extract_formal_script(writer_text: str) -> str:
    """Extract only the formal script body from the second-round LLM response.

    The model often emits markdown headings such as ``### **正式文案**`` instead of
    the older ``【正式文案】`` marker.  If we fail to cut at that heading, the
    frontend preview and the time parser may receive the preceding analysis
    section as if it were script content.
    """
    text = str(writer_text or "").replace("\r\n", "\n").replace("\r", "\n").strip()
    if not text:
        return ""

    patterns = [
        r"【\s*正式文案\s*】",
        r"(?im)^\s*#{0,6}\s*\*{0,2}\s*正式文案\s*\*{0,2}\s*[：:]?\s*$",
        r"(?im)^\s*正式文案\s*[：:]\s*",
    ]
    best = None
    for pattern in patterns:
        for match in re.finditer(pattern, text):
            if best is None or match.start() < best.start():
                best = match
    if best is not None:
        text = text[best.end():].strip()

    # Drop common assistant preambles if a provider still prepends them.
    text = re.sub(
        r"(?is)^\s*(好的|收到|明白|已收到).{0,120}?(?:\n{2,}|---\s*\n+)",
        "",
        text,
    ).strip()
    return text

def run_two_round_narration_from_prompt(
    full_prompt: str,
    call_llm: Callable[[str], Any],
) -> str:
    if os.getenv("MOVIE_STORY_TWO_ROUND_DISABLE", "").lower() in {"1", "true", "yes", "on"}:
        return response_to_text(call_llm(full_prompt))

    raw_srt_text = extract_raw_srt(full_prompt)
    write_debug("last_original_single_prompt.txt", full_prompt)

    analysis_prompt = build_analysis_prompt(raw_srt_text)
    write_debug("last_analysis_prompt.txt", analysis_prompt)
    analysis_text = response_to_text(call_llm(analysis_prompt))
    write_debug("last_analysis_response.txt", analysis_text)

    writer_prompt = build_writer_prompt(analysis_text)
    write_debug("last_writer_prompt.txt", writer_prompt)
    writer_text = response_to_text(call_llm(writer_prompt))
    write_debug("last_writer_response.txt", writer_text)

    final_script = extract_formal_script(writer_text)
    write_debug("last_two_round_final_script.txt", final_script)
    return final_script
