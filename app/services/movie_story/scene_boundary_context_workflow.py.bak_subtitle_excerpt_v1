import re
from collections import Counter
from collections.abc import Iterable, Mapping, Sequence
from dataclasses import dataclass
from typing import Any


@dataclass(frozen=True)
class TimeRange:
    """秒级时间范围。"""

    start: float
    end: float

    @property
    def duration(self) -> float:
        """返回时长秒数。"""
        return max(0.0, self.end - self.start)


@dataclass(frozen=True)
class SceneBoundary:
    """语义场景边界。"""

    scene_id: str
    start: float
    end: float
    subtitles: tuple[dict[str, Any], ...]
    anchors: tuple[dict[str, Any], ...]

    @property
    def duration(self) -> float:
        """返回场景时长。"""
        return max(0.0, self.end - self.start)


DEFAULT_STOP_WORDS = {
    "一个", "这个", "那个", "我们", "你们", "他们", "什么", "怎么",
    "就是", "不是", "没有", "已经", "自己", "知道", "现在", "这里",
    "那里", "还有", "因为", "所以",
}


def build_scene_boundary_payload(
    *,
    subtitle_segments: Sequence[Mapping[str, Any]],
    shot_boundaries: Sequence[Mapping[str, Any]] | None = None,
    visual_anchors: Sequence[Mapping[str, Any]] | None = None,
    target_scene_count: int = 30,
    min_scene_duration: float = 45.0,
    max_scene_duration: float = 180.0,
) -> dict[str, Any]:
    """
    构建 scene_boundary_context payload。

    subtitle_segments: [{"start": 1.0, "end": 3.0, "text": "..."}]
    shot_boundaries: [{"start": 0.0, "end": 10.0}]
    visual_anchors: [{"time": 12.3, "description": "...", "confidence": 0.8}]
    """
    scenes = build_scene_boundaries(
        subtitle_segments=subtitle_segments,
        shot_boundaries=shot_boundaries or [],
        visual_anchors=visual_anchors or [],
        target_scene_count=target_scene_count,
        min_scene_duration=min_scene_duration,
        max_scene_duration=max_scene_duration,
    )
    context = build_scene_boundary_context(scenes)
    return {
        "scene_count": len(scenes),
        "scene_boundaries": [scene_to_dict(scene) for scene in scenes],
        "scene_boundary_context": context,
    }


def build_scene_boundaries(
    *,
    subtitle_segments: Sequence[Mapping[str, Any]],
    shot_boundaries: Sequence[Mapping[str, Any]] | None = None,
    visual_anchors: Sequence[Mapping[str, Any]] | None = None,
    target_scene_count: int = 30,
    min_scene_duration: float = 45.0,
    max_scene_duration: float = 180.0,
) -> list[SceneBoundary]:
    """
    生成语义场景边界。

    当前规则：
    1. 优先使用 shot_boundaries 的起点作为候选切分点。
    2. 没有 shot_boundaries 时，按字幕时间均匀切分。
    3. 避免过短 scene；过长 scene 会按字幕时间再切。
    """
    normalized_subtitles = normalize_subtitle_segments(subtitle_segments)
    if not normalized_subtitles:
        return []

    video_start = min(float(item["start"]) for item in normalized_subtitles)
    video_end = max(float(item["end"]) for item in normalized_subtitles)

    candidate_ranges = build_candidate_ranges(
        video_start=video_start,
        video_end=video_end,
        shot_boundaries=shot_boundaries or [],
        target_scene_count=target_scene_count,
        min_scene_duration=min_scene_duration,
        max_scene_duration=max_scene_duration,
    )
    candidate_ranges = split_long_ranges_by_subtitles(
        candidate_ranges,
        normalized_subtitles,
        max_scene_duration=max_scene_duration,
    )

    anchors = normalize_visual_anchors(visual_anchors or [])
    scenes: list[SceneBoundary] = []
    for index, time_range in enumerate(candidate_ranges, start=1):
        scene_subtitles = tuple(
            item
            for item in normalized_subtitles
            if overlaps(float(item["start"]), float(item["end"]), time_range.start, time_range.end)
        )
        scene_anchors = tuple(
            anchor
            for anchor in anchors
            if time_range.start <= float(anchor["time"]) <= time_range.end
        )
        if not scene_subtitles and not scene_anchors:
            continue
        scenes.append(
            SceneBoundary(
                scene_id=f"scene_{index:03d}",
                start=time_range.start,
                end=time_range.end,
                subtitles=scene_subtitles,
                anchors=scene_anchors,
            )
        )

    return renumber_scenes(scenes)


def build_candidate_ranges(
    *,
    video_start: float,
    video_end: float,
    shot_boundaries: Sequence[Mapping[str, Any]],
    target_scene_count: int,
    min_scene_duration: float,
    max_scene_duration: float,
) -> list[TimeRange]:
    """基于 shot boundaries 或均匀切分生成候选 scene ranges。"""
    normalized_shots = normalize_time_ranges(shot_boundaries)
    if not normalized_shots:
        return build_uniform_ranges(
            start=video_start,
            end=video_end,
            target_scene_count=target_scene_count,
            max_scene_duration=max_scene_duration,
        )

    ranges: list[TimeRange] = []
    current_start = normalized_shots[0].start
    current_end = normalized_shots[0].end

    for shot in normalized_shots[1:]:
        current_duration = current_end - current_start
        should_cut = current_duration >= min_scene_duration
        should_force_cut = current_duration >= max_scene_duration

        if should_cut or should_force_cut:
            ranges.append(TimeRange(current_start, current_end))
            current_start = shot.start
            current_end = shot.end
        else:
            current_end = max(current_end, shot.end)

    ranges.append(TimeRange(current_start, current_end))
    return merge_tiny_ranges(ranges, min_scene_duration=min_scene_duration)


def build_uniform_ranges(*, start: float, end: float, target_scene_count: int, max_scene_duration: float) -> list[TimeRange]:
    """没有 shot 时按时间均匀切。"""
    duration = max(0.0, end - start)
    if duration <= 0:
        return []
    count = max(1, min(max(1, target_scene_count), max(1, int(round(duration / max_scene_duration)))))
    step = duration / count
    return [
        TimeRange(start + index * step, end if index == count - 1 else start + (index + 1) * step)
        for index in range(count)
    ]


def split_long_ranges_by_subtitles(
    ranges: Sequence[TimeRange],
    subtitles: Sequence[Mapping[str, Any]],
    *,
    max_scene_duration: float,
) -> list[TimeRange]:
    """过长 scene 按字幕时间继续拆分。"""
    output: list[TimeRange] = []
    for time_range in ranges:
        if time_range.duration <= max_scene_duration:
            output.append(time_range)
            continue

        sub_in_range = [
            item
            for item in subtitles
            if time_range.start <= float(item["start"]) <= time_range.end
        ]
        if not sub_in_range:
            output.append(time_range)
            continue

        current_start = time_range.start
        for item in sub_in_range:
            subtitle_start = float(item["start"])
            subtitle_end = float(item["end"])
            if subtitle_end - current_start >= max_scene_duration:
                cut_point = min(subtitle_start, current_start + max_scene_duration) if subtitle_start > current_start else min(subtitle_end, current_start + max_scene_duration)
                if cut_point - current_start > 1:
                    output.append(TimeRange(current_start, cut_point))
                    current_start = cut_point
        if time_range.end - current_start > 1:
            output.append(TimeRange(current_start, time_range.end))
    return output


def build_scene_boundary_context(scenes: Sequence[SceneBoundary]) -> str:
    """格式化 scene_boundary_context。"""
    return "\n\n".join(format_scene_boundary(scene) for scene in scenes).strip()


def format_scene_boundary(scene: SceneBoundary) -> str:
    """格式化单个 scene block。"""
    keywords = extract_keywords([str(item.get("text") or "") for item in scene.subtitles])
    people = extract_people_from_anchors(scene.anchors)
    visual_fact = build_visual_fact(scene.anchors)
    anchor_text = build_anchor_text(scene.anchors)

    return "\n".join(
        [
            f"{scene.scene_id} | {format_time(scene.start)}~{format_time(scene.end)} | {int(round(scene.duration))}秒",
            f"在场人物：{people}",
            f"画面事实：{visual_fact}",
            f"画面锚点：{anchor_text}",
            f"字幕关键词：{' '.join(keywords) if keywords else '无'}",
        ]
    )


def extract_people_from_anchors(anchors: Sequence[Mapping[str, Any]]) -> str:
    """从视觉锚点中读取在场人物；无数据时不编造。"""
    people: list[str] = []
    for anchor in anchors:
        for item in anchor.get("people", []) or []:
            if isinstance(item, str):
                people.append(item)
            elif isinstance(item, Mapping):
                name = str(item.get("name") or "").strip()
                confidence = item.get("confidence")
                if name and confidence is not None:
                    people.append(f"{name}({float(confidence):.2f})")
                elif name:
                    people.append(name)
    unique = deduplicate_preserve_order(people)
    return " ".join(unique) if unique else "未提供"


def build_visual_fact(anchors: Sequence[Mapping[str, Any]]) -> str:
    """汇总画面事实；无视觉输入时明确说明未提供。"""
    descriptions = [
        str(anchor.get("description") or "").strip()
        for anchor in anchors
        if str(anchor.get("description") or "").strip()
    ]
    if not descriptions:
        return "未提供视觉锚点，不能从字幕推断画面事实"
    return "；".join(deduplicate_preserve_order(descriptions[:4]))


def build_anchor_text(anchors: Sequence[Mapping[str, Any]]) -> str:
    """格式化画面锚点。"""
    if not anchors:
        return "未提供"
    parts = []
    for anchor in anchors[:5]:
        time_text = format_time(float(anchor["time"]))
        description = str(anchor.get("description") or "视觉锚点").strip()
        confidence = anchor.get("confidence")
        if confidence is None:
            parts.append(f"{time_text} {description}")
        else:
            parts.append(f"{time_text} {description}({float(confidence):.2f})")
    return "；".join(parts)


def extract_keywords(texts: Iterable[str], *, limit: int = 8) -> list[str]:
    """从字幕文本中抽取轻量关键词。"""
    tokens: list[str] = []
    for text in texts:
        tokens.extend(tokenize_text(text))
    counter = Counter(token for token in tokens if token not in DEFAULT_STOP_WORDS and len(token) >= 2)
    return [token for token, _ in counter.most_common(limit)]


def tokenize_text(text: str) -> list[str]:
    """简单 token 化：连续中文 2~6 字为候选，英文数字按词。"""
    cleaned = re.sub(r"[，。！？、,.!?；;：:（）()【】\[\]《》\"'“”]", " ", text)
    tokens: list[str] = []
    for part in cleaned.split():
        if re.search(r"[\u4e00-\u9fff]", part):
            tokens.extend(re.findall(r"[\u4e00-\u9fff]{2,6}", part))
        else:
            tokens.extend(re.findall(r"[A-Za-z0-9_]{2,}", part))
    return tokens


def normalize_subtitle_segments(subtitle_segments: Sequence[Mapping[str, Any]]) -> list[dict[str, Any]]:
    """归一化字幕片段。"""
    normalized = []
    for item in subtitle_segments:
        try:
            start = parse_time_value(item.get("start"))
            end = parse_time_value(item.get("end"))
        except (TypeError, ValueError):
            continue
        if end <= start:
            continue
        normalized.append({"start": start, "end": end, "text": str(item.get("text") or "").strip()})
    return sorted(normalized, key=lambda item: (item["start"], item["end"]))


def normalize_time_ranges(items: Sequence[Mapping[str, Any]]) -> list[TimeRange]:
    """归一化时间范围。"""
    ranges = []
    for item in items:
        try:
            start = parse_time_value(item.get("start"))
            end = parse_time_value(item.get("end"))
        except (TypeError, ValueError):
            continue
        if end > start:
            ranges.append(TimeRange(start, end))
    return sorted(ranges, key=lambda item: (item.start, item.end))


def normalize_visual_anchors(items: Sequence[Mapping[str, Any]]) -> list[dict[str, Any]]:
    """归一化视觉锚点。"""
    anchors = []
    for item in items:
        try:
            time_value = parse_time_value(item.get("time"))
        except (TypeError, ValueError):
            continue
        anchors.append(
            {
                "time": time_value,
                "description": str(item.get("description") or "").strip(),
                "confidence": item.get("confidence"),
                "people": item.get("people") or [],
            }
        )
    return sorted(anchors, key=lambda item: item["time"])


def merge_tiny_ranges(ranges: Sequence[TimeRange], *, min_scene_duration: float) -> list[TimeRange]:
    """合并过短 scene。"""
    merged: list[TimeRange] = []
    for time_range in ranges:
        if not merged:
            merged.append(time_range)
            continue
        if time_range.duration < min_scene_duration:
            previous = merged.pop()
            merged.append(TimeRange(previous.start, time_range.end))
        else:
            merged.append(time_range)
    return merged


def renumber_scenes(scenes: Sequence[SceneBoundary]) -> list[SceneBoundary]:
    """重新编号 scene。"""
    return [
        SceneBoundary(
            scene_id=f"scene_{index:03d}",
            start=scene.start,
            end=scene.end,
            subtitles=scene.subtitles,
            anchors=scene.anchors,
        )
        for index, scene in enumerate(scenes, start=1)
    ]


def scene_to_dict(scene: SceneBoundary) -> dict[str, Any]:
    """SceneBoundary 转 dict。"""
    return {
        "scene_id": scene.scene_id,
        "start": scene.start,
        "end": scene.end,
        "duration": scene.duration,
        "subtitle_count": len(scene.subtitles),
        "anchor_count": len(scene.anchors),
    }


def parse_time_value(value: Any) -> float:
    """解析秒数或 HH:MM:SS / MM:SS 时间。"""
    if isinstance(value, (int, float)):
        return float(value)
    raw = str(value or "").strip()
    if not raw:
        raise ValueError("empty time")
    if raw.replace(".", "", 1).isdigit():
        return float(raw)

    parts = raw.replace(",", ".").split(":")
    if len(parts) == 2:
        minutes, seconds = parts
        return int(minutes) * 60 + float(seconds)
    if len(parts) == 3:
        hours, minutes, seconds = parts
        return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
    raise ValueError(f"invalid time: {value}")


def format_time(seconds: float) -> str:
    """格式化为 MM:SS。"""
    total = int(round(max(0.0, seconds)))
    minutes = total // 60
    remain = total % 60
    return f"{minutes:02d}:{remain:02d}"


def overlaps(start_a: float, end_a: float, start_b: float, end_b: float) -> bool:
    """判断两个时间段是否重叠。"""
    return max(start_a, start_b) < min(end_a, end_b)


def deduplicate_preserve_order(items: Sequence[str]) -> list[str]:
    """保序去重。"""
    seen = set()
    output = []
    for item in items:
        if item and item not in seen:
            output.append(item)
            seen.add(item)
    return output
