def _build_raw_subtitle_timeline_text(scene_evidence: List[Dict], *, max_chars: int = 120000) -> str:
    """只把带时间戳的原版字幕交给大模型；不塞 plot_function / segment_id / char_budget 等干扰字段。"""
    lines: List[str] = []
    total = 0
    for idx, item in enumerate(scene_evidence or [], start=1):
        if not isinstance(item, dict):
            continue
        start, end = _pkg_start_end(item)
        text = str(item.get("text") or item.get("subtitle_text") or item.get("main_text_evidence") or item.get("source_text") or "").strip()
        if not text:
            continue
        line = f"{idx}. [{utils.format_time(start)}-{utils.format_time(end)}] {text}"
        if total + len(line) > max_chars:
            break
        lines.append(line)
        total += len(line)
    return "\n".join(lines)


def _build_user_template_raw_subtitle_prompt(scene_evidence: List[Dict], *, style: str, video_title: str = "") -> str:
    template = _style_template_directive(style).strip() or STYLE_GUIDE.get(style, STYLE_GUIDE["default"])
    subtitles = _build_raw_subtitle_timeline_text(scene_evidence)
    title_line = f"\n\n【视频标题】\n{video_title.strip()}" if str(video_title or "").strip() else ""
    return f"{template}{title_line}\n\n【带时间戳的原版字幕】\n{subtitles}".strip()


_TIME_RANGE_RE = re.compile(
    r"(?P<start>\d{1,2}:\d{2}(?::\d{2})?(?:[,.]\d{1,3})?)\s*(?:-|—|–|~|～|至|到)\s*(?P<end>\d{1,2}:\d{2}(?::\d{2})?(?:[,.]\d{1,3})?)"
)


def _safe_time_to_seconds(value, default: float = 0.0) -> float:
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value or "").strip().replace("，", ",")
    if not text:
        return default
    try:
        return float(text)
    except Exception:
        pass
    try:
        parts = text.replace(",", ".").split(":")
        if len(parts) == 2:
            m, s = parts
            return int(m) * 60 + float(s)
        if len(parts) == 3:
            h, m, s = parts
            return int(h) * 3600 + int(m) * 60 + float(s)
    except Exception:
        return default
    return default


def _parse_time_hint(value: str) -> tuple[float, float] | None:
    match = _TIME_RANGE_RE.search(str(value or ""))
    if not match:
        return None
    start = _safe_time_to_seconds(match.group("start"), 0.0)
    end = _safe_time_to_seconds(match.group("end"), start)
    if end <= start:
        return None
    return start, end


def _extract_rough_timeline_rows(raw: str) -> List[Dict]:
    """兼容 JSON 或普通文本时间轴；不要求模型必须按额外 JSON 规则输出。"""
    rows: List[Dict] = []
    parsed = _extract_json_obj(raw)
    if isinstance(parsed, dict):
        candidates = parsed.get("rough_timeline") or parsed.get("items") or parsed.get("segments") or parsed.get("timeline")
        if isinstance(candidates, list):
            for idx, row in enumerate(candidates, start=1):
                if not isinstance(row, dict):
                    continue
                narration = str(row.get("narration") or row.get("text") or row.get("解说") or row.get("文案") or "").strip()
                time_hint = str(row.get("source_time_hint") or row.get("time") or row.get("timestamp") or row.get("时间") or "")
                start = row.get("source_start", row.get("start", row.get("开始时间")))
                end = row.get("source_end", row.get("end", row.get("结束时间")))
                if start is None or end is None:
                    parsed_hint = _parse_time_hint(time_hint)
                    if parsed_hint:
                        start, end = parsed_hint
                start_s = _safe_time_to_seconds(start, 0.0)
                end_s = _safe_time_to_seconds(end, start_s)
                if narration and end_s > start_s:
                    rows.append({
                        "order": idx,
                        "block_id": str(row.get("block_id") or row.get("id") or f"rough_{idx:03d}"),
                        "start": start_s,
                        "end": end_s,
                        "narration": narration,
                    })
            if rows:
                return rows

    text = str(raw or "").strip()
    matches = list(_TIME_RANGE_RE.finditer(text))
    for idx, match in enumerate(matches, start=1):
        start = _safe_time_to_seconds(match.group("start"), 0.0)
        end = _safe_time_to_seconds(match.group("end"), start)
        body_start = match.end()
        body_end = matches[idx].start() if idx < len(matches) else len(text)
        body = text[body_start:body_end].strip()
        body = re.sub(r"^[\s\]】）)\-—–:：]+", "", body).strip()
        body = re.sub(r"^(解说文案|解说|文案|旁白)[:：]", "", body).strip()
        if body and end > start:
            rows.append({
                "order": idx,
                "block_id": f"rough_{idx:03d}",
                "start": start,
                "end": end,
                "narration": body,
            })
    return rows


def _subtitle_text_in_range(scene_evidence: List[Dict], start: float, end: float, *, limit: int = 1200) -> str:
    parts: List[str] = []
    for item in scene_evidence or []:
        if not isinstance(item, dict):
            continue
        s, e = _pkg_start_end(item)
        if max(0.0, min(end, e) - max(start, s)) <= 0:
            continue
        text = str(item.get("text") or item.get("subtitle_text") or item.get("main_text_evidence") or item.get("source_text") or "").strip()
        if text:
            parts.append(text)
        if sum(len(x) for x in parts) >= limit:
            break
    return " ".join(parts)[:limit]


def _build_script_items_from_rough_timeline(rows: List[Dict], scene_evidence: List[Dict], *, global_summary: Dict, style: str) -> List[Dict]:
    items: List[Dict] = []
    for idx, row in enumerate(rows or [], start=1):
        start = float(row.get("start") or 0.0)
        end = float(row.get("end") or start)
        narration = str(row.get("narration") or "").strip()
        if not narration or end <= start:
            continue
        segment_id = str(row.get("block_id") or f"rough_{idx:03d}")
        timestamp = f"{utils.format_time(start)}-{utils.format_time(end)}"
        source_text = _subtitle_text_in_range(scene_evidence, start, end)
        duration = max(end - start, 0.5)
        item = {
            "_id": idx,
            "timestamp": timestamp,
            "source_timestamp": timestamp,
            "picture": narration[:80] or "按粗时间轴找画面",
            "narration": narration,
            "OST": 0,
            "composition_audio_mode": "tts",
            "segment_id": segment_id,
            "scene_id": segment_id,
            "highlight_id": segment_id,
            "start": round(start, 3),
            "end": round(end, 3),
            "duration": round(duration, 3),
            "main_text_evidence": source_text,
            "clip_text_evidence": source_text[:500],
            "clip_match_rule": "rough_subtitle_time_range",
            "generation_mode": "raw_subtitle_template_rough_timeline",
            "llm_highlight_selected": True,
            "highlight_filter_selected": True,
            "narration_validation": {"status": "skipped", "issues": []},
            "narration_quality": {"source": "user_template_raw_subtitle"},
            "fit_check": fit_check(narration, duration),
            "global_arc": (global_summary or {}).get("arc"),
            "narration_style": style,
        }
        items.append(item)
    return _postprocess_script_items(items)


def _generate_historical_raw_subtitle_script_items(
    scene_evidence: List[Dict],
    *,
    api_key: str,
    base_url: str,
    model: str,
    style: str,
    video_title: str,
    global_summary: Dict,
) -> List[Dict]:
    if not (api_key and model):
        return []
    prompt = _build_user_template_raw_subtitle_prompt(scene_evidence, style=style, video_title=video_title)
    raw = _call_chat_completion(prompt, api_key=api_key, base_url=base_url, model=model, timeout=180)
    rows = _extract_rough_timeline_rows(raw)
    if not rows:
        raise ValueError("大模型未返回可解析的粗时间轴解说")
    return _build_script_items_from_rough_timeline(rows, scene_evidence, global_summary=global_summary or {}, style=style)
