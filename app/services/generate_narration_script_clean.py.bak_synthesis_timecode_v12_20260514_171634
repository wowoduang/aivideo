@lru_cache(maxsize=1)
def _load_narration_style_templates() -> Dict:
    path = Path(__file__).resolve().parent / "movie_story" / "narration_style_templates.json"
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
        return raw if isinstance(raw, dict) else {}
    except Exception as exc:
        logger.warning("读取解说风格模板库失败: path={}, error={}", path, exc)
        return {}


def _render_style_template(template: Dict) -> str:
    if not isinstance(template, dict):
        return ""

    prompt = str(template.get("prompt") or "").strip()
    if prompt:
        title = str(template.get("title") or "").strip()
        return "\n" + "\n\n".join(part for part in (title, prompt) if part).strip() + "\n"

    lines: List[str] = []
    title = str(template.get("title") or "").strip()
    if title:
        lines.append(title)
    for section in template.get("sections") or []:
        if not isinstance(section, dict):
            continue
        heading = str(section.get("heading") or "").strip()
        if heading:
            lines.extend(["", heading])
        content = section.get("content")
        if isinstance(content, str) and content.strip():
            lines.append(content.strip())
        elif isinstance(content, list):
            for item in content:
                item_text = str(item or "").strip()
                if item_text:
                    lines.append(item_text)
        for line in section.get("lines") or []:
            line_text = str(line or "").strip()
            if line_text:
                lines.append(line_text)
    return "\n" + "\n".join(lines).strip() + "\n" if lines else ""


def _style_template_directive(style: str) -> str:
    template = _load_narration_style_templates().get(style)
    return _render_style_template(template)


def _build_style_guide(style: str, movie_category: str = "") -> str:
    guide = STYLE_GUIDE.get(style, STYLE_GUIDE["default"])
    if style not in _FAST_CUT_STYLES:
        guide += _narration_quality_style_directive()
    guide += _style_template_directive(style)
    return guide

