def _raw_srt_read_file(path: str) -> str:
    if not path:
        return ""
    for encoding in ("utf-8", "utf-8-sig", "gbk", "cp936"):
        try:
            return Path(path).read_text(encoding=encoding)
        except UnicodeDecodeError:
            continue
        except Exception:
