def generate_narration_from_scene_evidence(
    scene_evidence: List[Dict],
    api_key: str,
    base_url: str,
    model: str,
    style: str = "documentary",
    video_title: str = "",
) -> List[Dict]:
    if not scene_evidence:
        return []

    global_summary = {}
    if scene_evidence and isinstance(scene_evidence[0].get("_global_summary"), dict):
        global_summary = scene_evidence[0]["_global_summary"]

    normalized_style = style if style in STYLE_GUIDE else "default"
    effective_video_title = str(video_title or global_summary.get("video_title") or "").strip()
    movie_category = _infer_movie_category(effective_video_title, global_summary or {}, scene_evidence)
    style_guide = _build_style_guide(normalized_style, movie_category)
    style_examples = "\n".join(f"- {x}" for x in STYLE_EXAMPLES.get(normalized_style, STYLE_EXAMPLES["general"]))

    packages = _prepare_narration_packages(scene_evidence, normalized_style)
    if normalized_style in _FAST_CUT_STYLES:
        if api_key and model:
            try:
                script_items = _generate_historical_raw_subtitle_script_items(
                    scene_evidence,
                    api_key=api_key,
                    base_url=base_url,
                    model=model,
                    style=normalized_style,
                    video_title=effective_video_title,
                    global_summary=global_summary or {},
                )
                if script_items:
                    logger.warning("历史正剧链路已改为：用户原始模板 + 带时间戳原版字幕 → 粗时间轴解说，items={}", len(script_items))
                    return script_items
            except Exception as exc:
                logger.exception("历史正剧原始字幕粗时间轴解说生成失败，回退原声粗切: {}", exc)
        logger.warning(
            "历史剧粗时间轴解说未生成，回退原声粗切: package_count={}, rule=subtitle_time_to_original_video",
            len(packages),
        )
        return _build_direct_cut_script_items(packages, global_summary=global_summary or {}, style=normalized_style)

    batch_project_context = {
        "video_title": effective_video_title,
        "movie_category_hint": movie_category,
        "narration_style": normalized_style,
        "narration_style_label": STYLE_LABELS.get(normalized_style, STYLE_LABELS["default"]),
        "segment_count": len(packages),
        "writing_mode": "historical_fast_cut_timeline" if normalized_style in _FAST_CUT_STYLES else "full_subtitle_timeline_first",
        "timeline_rule": (
            "快速版：source_timeline_json 是整集字幕理解上下文；timeline_json 是用字幕时间粗分出来的裁剪窗口。"
            "必须按 timeline_json 的 segment_id/start/end 回填，后续直接用这些字幕时间去切原片，不要再跨段合并。"
            if normalized_style in _FAST_CUT_STYLES
            else "先根据全部字幕证据写连续解说，再按 segment_id/start/end 回填每个片段。"
        ),
        "visual_rule": "visual_evidence 只用于增强画面质感；没有画面证据时不编具体动作。",
    }
    batch_generation_results = _generate_full_subtitle_batch_narration(
        packages,
        source_evidence=scene_evidence,
        global_summary=global_summary or {},
        project_context=batch_project_context,
        style_guide=style_guide,
        style_examples=style_examples,
        movie_category=movie_category,
        api_key=api_key,
        base_url=base_url,
        model=model,
        style=normalized_style,
    )
    original_audio_keys: List[str] = []
    if len(packages) >= 2:
        for pkg in packages:
            key = str(pkg.get("_narration_segment_key") or "")
            if key and key not in batch_generation_results:
                batch_generation_results[key] = _missing_narration_original_audio(pkg)
                original_audio_keys.append(key)
        if original_audio_keys:
            logger.warning(
                "整字幕时间轴解说生成不完整，缺文案片段改为原声: missing_count={}, missing={}",
                len(original_audio_keys),
                ", ".join(original_audio_keys[:24]),
            )
    if len(packages) >= 2:
        missing_keys = [
            str(pkg.get("_narration_segment_key") or "")
            for pkg in packages
            if str(pkg.get("_narration_segment_key") or "") not in batch_generation_results
        ]
        if missing_keys:
            raise ValueError(
                "整字幕时间轴解说生成不完整，已停止交付；缺失片段: "
                + ", ".join(missing_keys[:12])
            )

    script_items: List[Dict] = []
    segment_count = len(packages)
    for idx, pkg in enumerate(packages, start=1):
        start, end = _pkg_start_end(pkg)
        char_budget = int(pkg.get("char_budget") or 80)
        project_context = _build_project_context(
            video_title=effective_video_title,
            style=normalized_style,
            movie_category=movie_category,
            pkg=pkg,
            segment_index=idx,
            segment_count=segment_count,
        )

        generation_result = dict(batch_generation_results.get(str(pkg.get("_narration_segment_key") or "")) or {})
        if not generation_result and api_key and model and len(packages) == 1:
            prompt = PromptManager.get_prompt(
                "movie_story_narration",
                "narration_generation",
                parameters={
                    "segment_json": json.dumps(
                        {
                            "segment_id": pkg.get("segment_id"),
                            "highlight_id": pkg.get("highlight_id"),
                            "timestamp": pkg.get("timestamp"),
                            "start": round(start, 3),
                            "end": round(end, 3),
                            "plot_function": pkg.get("plot_function"),
                            "importance_level": pkg.get("importance_level"),
                            "surface_dialogue_meaning": pkg.get("surface_dialogue_meaning"),
                            "real_narrative_state": pkg.get("real_narrative_state"),
                            "local_understanding": pkg.get("local_understanding"),
                            "story_validation": pkg.get("story_validation"),
                            "raw_voice_retain_suggestion": pkg.get("raw_voice_retain_suggestion"),
                            "emotion_hint": pkg.get("emotion_hint"),
                            "main_text_evidence": pkg.get("main_text_evidence") or pkg.get("subtitle_text"),
                            "visual_summary": list(pkg.get("visual_summary") or [])[:4],
                            "segment_visual_card": pkg.get("segment_visual_card") or {},
                            "visual_evidence_pack": pkg.get("visual_evidence_pack") or {},
                            "frame_paths": list(pkg.get("frame_paths") or [])[:6],
                            "representative_frames": list(pkg.get("representative_frames") or [])[:4],
                            "speaker_names": list(pkg.get("speaker_names") or []),
                            "speaker_turns": int(pkg.get("speaker_turns", 0) or 0),
                            "exchange_pairs": list(pkg.get("exchange_pairs") or []),
                            "speaker_attribution_confidence": _speaker_attribution_confidence(pkg),
                            "is_opening_segment": bool(pkg.get("is_opening_segment")),
                            "current_clip_match_rule": "必须只讲 start/end 当前时间窗内发生的内容；可以使用全局摘要理解人物关系，但不能把前后剧情写进当前片段。",
                            "allowed_visual_time_drift_seconds": 3,
                            "do_not_narrate_next_or_previous_segment": True,
                            "current_clip_text_evidence": pkg.get("main_text_evidence") or pkg.get("subtitle_text") or "",
                            "current_clip_visual_evidence": list(pkg.get("visual_summary") or [])[:4],
                        },
                        ensure_ascii=False,
                        indent=2,
                    ),
                    "global_summary_json": json.dumps(global_summary or {}, ensure_ascii=False, indent=2),
                    "project_context_json": json.dumps(project_context or {}, ensure_ascii=False, indent=2),
                    "style_guide": style_guide,
                    "style_examples": style_examples,
                    "char_budget": char_budget,
                },
            )
            raw = _call_chat_completion(prompt, api_key=api_key, base_url=base_url, model=model)
            parsed = _extract_json_obj(raw)
            if isinstance(parsed, dict):
                if not parsed.get("narration") and isinstance(parsed.get("items"), list):
                    target_key = str(pkg.get("_narration_segment_key") or pkg.get("segment_id") or "")
                    parsed_item = None
                    for item in parsed.get("items") or []:
                        if not isinstance(item, dict):
                            continue
                        item_key = str(item.get("segment_id") or item.get("id") or "")
                        if parsed_item is None or (target_key and item_key == target_key):
                            parsed_item = item
                        if target_key and item_key == target_key:
                            break
                    if parsed_item:
                        parsed = dict(parsed_item)
                generation_result = parsed
                generation_result["narration"] = _postprocess_candidate_narration(
                    generation_result.get("narration", ""),
                    pkg,
                    char_budget,
                    normalized_style,
                )
                if _is_verbatim_like(generation_result.get("narration", ""), pkg):
                    repaired = _repair_verbatim_with_llm(
                        pkg,
                        generation_result.get("narration", ""),
                        normalized_style,
                        char_budget,
                        api_key,
                        base_url,
                        model,
                    )
                    if not repaired:
                        raise ValueError(f"解说生成疑似复述字幕且修复失败: segment={pkg.get('_narration_segment_key')}")
                    generation_result["narration"] = repaired
                    generation_result["risk_note"] = (
                        f"{generation_result.get('risk_note', '')}；anti_verbatim_rewrite"
                    ).strip("；")
                if _has_analysis_cliche(generation_result.get("narration", "")):
                    generation_result = _missing_narration_original_audio(pkg)
                    generation_result["risk_note"] = "narration_rejected_use_original_audio:analysis_cliche"
                    generation_result["narration_quality_rejected_to_original_audio"] = True
                    generation_result["narration_quality_reject_reason"] = "analysis_cliche"

        if (
            generation_result
            and not generation_result.get("narration_missing_use_original_audio")
            and not str(generation_result.get("narration") or "").strip()
        ):
            generation_result = _missing_narration_original_audio(pkg)

        if not generation_result:
            raise ValueError(f"解说生成失败，未返回可交付文案: segment={pkg.get('_narration_segment_key')}")
        elif generation_result.get("narration_missing_use_original_audio"):
            generation_result["narration_validation"] = {
                "status": "skipped",
                "issues": ["missing_narration_use_original_audio"],
            }
        else:
            validation = _validate_generated_narration(
                pkg,
                generation_result.get("narration", ""),
                bool(generation_result.get("raw_voice_keep")),
                project_context,
                api_key=api_key,
                base_url=base_url,
                model=model,
            )
            generation_result["narration_validation"] = validation
            if validation.get("status") == "reject":
                raise ValueError(
                    f"解说文案校验拒绝，已停止交付: segment={pkg.get('_narration_segment_key')}, "
                    f"issues={';'.join(validation.get('issues') or [])}"
                )
            elif validation.get("status") == "review":
                generation_result["narration"] = _resolve_review_narration_text(
                    generation_result.get("narration", ""),
                    validation,
                    char_budget,
                )
                generation_result["narration"] = _postprocess_candidate_narration(
                    generation_result.get("narration", ""),
                    pkg,
                    char_budget,
                    normalized_style,
                )
                if _is_verbatim_like(generation_result.get("narration", ""), pkg):
                    repaired = _repair_verbatim_with_llm(
                        pkg,
                        generation_result.get("narration", ""),
                        normalized_style,
                        char_budget,
                        api_key,
                        base_url,
                        model,
                    )
                    if not repaired:
                        raise ValueError(f"解说 review 后仍疑似复述字幕: segment={pkg.get('_narration_segment_key')}")
                    generation_result["narration"] = repaired
                    generation_result["risk_note"] = (
                        f"{generation_result.get('risk_note', '')}；anti_verbatim_rewrite"
                    ).strip("；")
                if _has_analysis_cliche(generation_result.get("narration", "")):
                    generation_result = _missing_narration_original_audio(pkg)
                    generation_result["risk_note"] = "narration_rejected_use_original_audio:analysis_cliche_after_review"
                    generation_result["narration_quality_rejected_to_original_audio"] = True
                    generation_result["narration_quality_reject_reason"] = "analysis_cliche_after_review"
                generation_result["raw_voice_keep"] = bool(
                    generation_result.get("raw_voice_keep") and _can_keep_raw_voice(pkg)
                )
                generation_result["risk_note"] = (
                    f"{generation_result.get('risk_note', '')}；"
                    f"narration_review:{';'.join(validation.get('issues') or [])}"
                ).strip("；")

        picture = pkg.get("picture") or "；".join(x.get("desc", "") for x in (pkg.get("visual_summary") or [])[:2])
        try:
            script_item = _build_script_item(idx, pkg, generation_result, picture, global_summary or {}, normalized_style)
            if generation_result.get("narration_quality_rejected_to_original_audio"):
                script_item["narration_quality_rejected_to_original_audio"] = True
                script_item["narration_quality_reject_reason"] = generation_result.get("narration_quality_reject_reason")
        except ValueError as exc:
            logger.warning(
                "解说文案不合格，片段改为原声: segment={}, error={}",
                pkg.get("_narration_segment_key") or pkg.get("segment_id"),
                exc,
            )
            generation_result = _missing_narration_original_audio(pkg)
            generation_result["risk_note"] = f"narration_rejected_use_original_audio:{exc}"
            script_item = _build_script_item(idx, pkg, generation_result, picture, global_summary or {}, normalized_style)
            script_item["narration_quality_rejected_to_original_audio"] = True
            script_item["narration_quality_reject_reason"] = str(exc)
        script_items.append(script_item)

    final_items = _postprocess_script_items(script_items)
    scored_final_items = [
        item for item in final_items
        if int(item.get("OST", 2) or 2) != 1 or str(item.get("narration") or "").strip()
    ]
    final_score = score_narration_items(
        scored_final_items,
        source_text=" ".join(str(pkg.get("main_text_evidence") or pkg.get("subtitle_text") or "") for pkg in packages),
        expected_total=len(scored_final_items),
    )
    final_score["original_audio_only_count"] = len(final_items) - len(scored_final_items)
    if not final_score.get("passed"):
        raise ValueError(f"解说文案质量门禁未通过，已停止交付: {json.dumps(final_score, ensure_ascii=False)}")
    if final_items:
        final_items[0].setdefault("prompt_strategy_final_score", final_score)
    return final_items

