def _raw_srt_to_seconds(value, default: float = 0.0) -> float:
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value or "").strip()
    if not text:
        return default
    text = text.replace("：", ":").replace("，", ",").replace(" ", "").strip("[]【】()（）")
    try:
        return float(text)
    except Exception:
        pass
    try:
        parts = text.replace(",", ".").split(":")
        if len(parts) == 2:
            return int(parts[0]) * 60 + float(parts[1])
        if len(parts) == 3:
            return int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])
    except Exception:
        return default
    return default


def _raw_srt_clean_narration(text: str) -> str:
    """Clean one formal-script section body.

    Keep the real narration text. Remove section titles, timecode/clip lines,
    calculation notes, and labels like "文案正文：" while preserving text after
    the label when it appears on the same line.
    """
    raw = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    raw = raw.replace("```json", "").replace("```", "")

    title_re = re.compile(
        r"^(?:#{1,6}\s*)?(?:\*\*)?\s*"
        r"(开场|收尾|结尾|回响|当下回响|分论点[一二三四五六七八九十百千万0-9]+|正式文案|最终文案|成片文案)"
        r"\s*(?:\*\*)?\s*(?:[（(].*?[）)])?\s*(?:[：:].*)?$"
    )
    time_line_re = re.compile(
        r"^(?:片段[一二三四五六七八九十百千万0-9]+)?\s*"
        r"\[?\s*\d{1,2}:\d{2}(?::\d{2})?\s*(?:~|-|—|–|到|至|-->|->)\s*"
        r"\d{1,2}:\d{2}(?::\d{2})?\s*\]?"
        r".*$"
    )
    calc_note_re = re.compile(
        r"^[（(].*(本段|朗读约需|继承片段|继承范围|片段合计|无需扩展|已扩展|是否扩展).*[）)]$"
    )
    meta_re = re.compile(
        r"^(选择主线|选定主线|主线|主论点|副主线|分论点序列|对应结构性事实编号)\s*[：:].*$"
    )
    inline_body_re = re.compile(r"^(?:文案正文|正文)\s*[：:]\s*")

    lines = []
    for line in raw.split("\n"):
        stripped = line.strip()
        if not stripped:
            lines.append("")
            continue

        normalized = stripped.strip("*# `\t ").strip()

        if not normalized:
            continue
        if title_re.match(normalized):
            continue
        if time_line_re.match(normalized):
            continue
        if calc_note_re.match(normalized):
            continue
        if meta_re.match(normalized):
            continue
        if normalized.startswith("如有多个片段"):
            continue
        if normalized.startswith("如果选择开场") or normalized.startswith("如果选择收尾"):
            continue
        if re.match(r"^#{1,6}\s*", stripped):
            continue
        if re.match(r"^《.*》.*$", normalized):
            continue
        if re.match(r"^(标题|片名|主题|解说稿|深度解说稿)[:：]", normalized):
            continue

        normalized = inline_body_re.sub("", normalized).strip()
        if normalized:
            lines.append(normalized)

    cleaned = "\n".join(lines)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned).strip()
    return cleaned







def _raw_srt_nested_list(obj):
    if not isinstance(obj, dict):
        return None
    for key in ("rough_timeline", "timeline", "items", "segments", "result", "data", "解说", "解说文案", "粗时间轴", "时间轴", "正文"):
        value = obj.get(key)
        if isinstance(value, list):
            return value
        if isinstance(value, dict):
            nested = _raw_srt_nested_list(value)
            if isinstance(nested, list):
                return nested
    return None


def _raw_srt_row_text(row: Dict) -> str:
    for key in ("narration", "text", "content", "script", "voiceover", "commentary", "解说", "解说词", "文案", "旁白", "正文", "内容"):
        value = row.get(key)
        if value:
            return str(value)
    return ""


def _raw_srt_row_time(row: Dict):
    start = None
    end = None
    for key in ("source_start", "start", "start_time", "开始", "开始时间"):
        if row.get(key) is not None:
            start = row.get(key)
            break
    for key in ("source_end", "end", "end_time", "结束", "结束时间"):
        if row.get(key) is not None:
            end = row.get(key)
            break
    if start is not None and end is not None:
        return start, end
    hint = " ".join(str(row.get(k) or "") for k in ("source_time_hint", "timestamp", "time", "时间", "时间范围", "range"))
    match = _RAW_SRT_TIME_RE.search(hint)
    if match:
        return match.group("start"), match.group("end")
    return start, end



def _raw_srt_seconds_from_timecode(value, default=0.0):
    s = str(value or "").strip().replace(",", ".")
    if not s:
        return float(default)
    parts = s.split(":")
    try:
        if len(parts) == 2:
            return float(parts[0]) * 60.0 + float(parts[1])
        if len(parts) == 3:
            return float(parts[0]) * 3600.0 + float(parts[1]) * 60.0 + float(parts[2])
        return float(s)
    except Exception:
        return float(default)


def _raw_srt_format_seconds_mmss(seconds):
    try:
        total = int(round(max(float(seconds or 0.0), 0.0)))
    except Exception:
        total = 0
    return f"{total // 60:02d}:{total % 60:02d}"


def _raw_srt_parse_visual_anchor_seconds(text):
    """Parse visual anchor lines like: 画面锚点 01:23，02:34."""
    raw = str(text or "")
    anchors = []
    for line in raw.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if "画面锚点" not in line:
            continue
        for m in re.finditer(r"(\d{1,2}:\d{2}(?::\d{2})?)", line):
            anchors.append(round(_raw_srt_seconds_from_timecode(m.group(1), 0.0), 3))
    seen = set()
    result = []
    for value in sorted(anchors):
        key = round(value, 3)
        if key not in seen:
            seen.add(key)
            result.append(value)
    return result


def _raw_srt_anchor_based_clip_range(source_start, source_end, narration, visual_anchors):
    """Cut the final clip around visual anchors inside the LLM source window."""
    source_start = float(source_start or 0.0)
    source_end = float(source_end or source_start)
    if source_end <= source_start:
        source_end = source_start + 0.5

    source_duration = max(source_end - source_start, 0.5)
    desired_duration = _raw_srt_estimated_duration_for_narration(narration, source_duration)
    desired_duration = max(min(float(desired_duration or source_duration), source_duration), 0.5)

    anchors = []
    for value in visual_anchors or []:
        try:
            sec = float(value)
        except Exception:
            continue
        if source_start <= sec <= source_end:
            anchors.append(sec)

    if not anchors:
        clip_start = source_start
        clip_end = min(source_end, source_start + desired_duration)
        return round(clip_start, 3), round(max(clip_end, clip_start + 0.5), 3)

    anchors = sorted(anchors)
    anchor_min = anchors[0]
    anchor_max = anchors[-1]

    # If several anchors are listed, keep them in the planned segment when possible.
    anchor_span = max(anchor_max - anchor_min, 0.0)
    desired_duration = max(desired_duration, min(source_duration, anchor_span + 4.0))
    desired_duration = min(desired_duration, source_duration)

    center = (anchor_min + anchor_max) / 2.0
    clip_start = center - desired_duration / 2.0
    clip_end = clip_start + desired_duration

    if clip_start < source_start:
        clip_start = source_start
        clip_end = clip_start + desired_duration
    if clip_end > source_end:
        clip_end = source_end
        clip_start = clip_end - desired_duration

    clip_start = max(source_start, clip_start)
    clip_end = min(source_end, clip_end)
    if clip_end <= clip_start:
        clip_start = source_start
        clip_end = min(source_end, source_start + desired_duration)

    return round(clip_start, 3), round(max(clip_end, clip_start + 0.5), 3)

def _raw_srt_extract_rows(script_text):
    """Parse final raw-SRT writer output into one row per formal section.

    Critical fix:
      opening/ending multi-clip lines often look like:
        片段一 [00:04:43 ~ 00:06:55] 这里是说明文字
      The parser must treat this as a clip line, not as body text, and still
      keep the following 文案正文 as the opening narration.
    """
    text = str(script_text or "").replace("\r\n", "\n").replace("\r", "\n")
    if not text.strip():
        return []

    m_start = re.search(r"【\s*正式文案开始\s*】", text)
    m_end = re.search(r"【\s*正式文案结束\s*】", text)
    if m_start:
        text = text[m_start.end(): m_end.start() if m_end and m_end.start() > m_start.end() else len(text)]

    section_title_pat = re.compile(
        r"(?m)^\s*(?:#{1,6}\s*)?(?:\*\*)?\s*"
        r"(开场|收尾|结尾|分论点[一二三四五六七八九十百千万0-9]+)"
        r"\s*(?:\*\*)?\s*(?:[（(].*?[）)])?\s*(?:[：:].*)?\s*$"
    )

    # Match a whole clip/timecode line and allow free explanation text after the timecode.
    time_pat = re.compile(
        r"(?m)^\s*(?P<prefix>片段[一二三四五六七八九十百千万0-9]+)?\s*"
        r"\[?\s*(?P<start>\d{1,2}:\d{2}(?::\d{2})?)"
        r"\s*(?:~|-|—|–|到|至|-->|->)\s*"
        r"(?P<end>\d{1,2}:\d{2}(?::\d{2})?)\s*\]?"
        r"\s*(?P<note>[^\n\r]*)$"
    )

    def to_seconds(value, default=0.0):
        raw = str(value or "").strip().replace(",", ".")
        parts = raw.split(":")
        try:
            if len(parts) == 2:
                return float(parts[0]) * 60.0 + float(parts[1])
            if len(parts) == 3:
                return float(parts[0]) * 3600.0 + float(parts[1]) * 60.0 + float(parts[2])
            return float(raw)
        except Exception:
            return float(default)

    def fmt(seconds):
        try:
            total = int(round(max(float(seconds or 0.0), 0.0)))
        except Exception:
            total = 0
        return f"{total // 60:02d}:{total % 60:02d}"

    sections = list(section_title_pat.finditer(text))
    if not sections:
        return []

    rows = []
    for sec_idx, sec in enumerate(sections, start=1):
        title = str(sec.group(1) or "").strip()
        block_start = sec.end()
        block_end = sections[sec_idx].start() if sec_idx < len(sections) else len(text)
        block = text[block_start:block_end]

        time_matches = list(time_pat.finditer(block))
        if not time_matches:
            continue

        clips = []
        for clip_idx, tm in enumerate(time_matches, start=1):
            start = to_seconds(tm.group("start"), 0.0)
            end = to_seconds(tm.group("end"), start)
            if end <= start:
                continue
            note = str(tm.group("note") or "").strip().strip("（）() ")
            clips.append(
                {
                    "index": clip_idx,
                    "start": round(float(start), 3),
                    "end": round(float(end), 3),
                    "duration": round(float(end - start), 3),
                    "timestamp": f"{fmt(start)}-{fmt(end)}",
                    "note": note,
                    "source": "writer_timecode",
                }
            )

        if not clips:
            continue

        body = block[time_matches[-1].end():]
        narration = _raw_srt_clean_narration(body)

        if not narration:
            # Current block only; never clean the whole final script.
            narration = _raw_srt_clean_narration(block)

        if not narration:
            continue

        primary = clips[0]
        rows.append(
            {
                "start": primary["start"],
                "end": primary["end"],
                "source_start": primary["start"],
                "source_end": primary["end"],
                "narration": narration,
                "text": narration,
                "section_title": title,
                "title": title,
                "source_clips": clips,
                "raw_srt_source_clips": clips,
                "multi_clip": len(clips) > 1,
                "source_clip_count": len(clips),
                "source_clip_total_duration": round(sum(float(c.get("duration", 0.0) or 0.0) for c in clips), 3),
                "raw_srt_order": len(rows) + 1,
                "generation_mode": "raw_srt_two_round_narration",
                "clip_match_rule": "raw_srt_time_range",
                "raw_srt_extract_mode": "section_multiclip_v10_keep_opening",
            }
        )

    return rows







def _raw_srt_subtitle_text_in_range(scene_evidence: List[Dict], start: float, end: float, *, limit: int = 1200) -> str:
    parts: List[str] = []
    for item in scene_evidence or []:
        if not isinstance(item, dict):
            continue
        try:
            item_start, item_end = _pkg_start_end(item)
        except Exception:
            continue
        if max(0.0, min(end, item_end) - max(start, item_start)) <= 0:
            continue
        text = str(item.get("text") or item.get("subtitle_text") or item.get("main_text_evidence") or item.get("source_text") or "").strip()
        if text:
            parts.append(text)
        if sum(len(part) for part in parts) >= limit:
            break
    return " ".join(parts)[:limit]


def _raw_srt_estimated_duration_for_narration(narration: str, declared_duration: float = 0.0) -> float:
    """Estimate final clip duration from narration length, capped inside source window."""
    text = str(narration or "").strip()
    try:
        source_window = max(float(declared_duration or 0.0), 0.5)
    except Exception:
        source_window = 0.5
    try:
        chars_per_second = max(float(os.getenv("MOVIE_STORY_RAW_SRT_CHARS_PER_SECOND", "4.0") or "4.0"), 0.1)
    except Exception:
        chars_per_second = 4.0
    try:
        extra_seconds = max(float(os.getenv("MOVIE_STORY_RAW_SRT_EXTRA_SECONDS", "2.0") or "2.0"), 0.0)
    except Exception:
        extra_seconds = 2.0
    try:
        min_clip_seconds = max(float(os.getenv("MOVIE_STORY_RAW_SRT_MIN_CLIP_SECONDS", "8") or "8"), 0.5)
    except Exception:
        min_clip_seconds = 8.0
    try:
        max_clip_seconds = float(os.getenv("MOVIE_STORY_RAW_SRT_MAX_CLIP_SECONDS", "180") or "180")
    except Exception:
        max_clip_seconds = 180.0

    if not text:
        planned = min(source_window, max_clip_seconds) if max_clip_seconds > 0 else source_window
        return round(max(planned, 0.5), 3)

    planned = max(len(text) / chars_per_second + extra_seconds, min_clip_seconds)
    planned = min(planned, source_window)
    if max_clip_seconds > 0:
        planned = min(planned, max_clip_seconds)
    return round(max(planned, 0.5), 3)



def _postprocess_raw_srt_items(items):
    """Preserve writer text and compute final clip range from visual anchors.

    The LLM timecode is treated as source_window.
    If visual anchors exist, final start/end are expanded around anchors.
    If not, final start/end start from source_window start and use narration length.
    """
    result = []
    for idx, raw in enumerate(items or [], start=1):
        if not isinstance(raw, dict):
            continue

        item = dict(raw)
        narration = _raw_srt_clean_narration(item.get("narration") or item.get("text") or "")
        if not narration:
            continue

        source_start = _raw_srt_seconds_from_timecode(
            item.get("source_start", item.get("start", 0.0)),
            0.0,
        )
        source_end = _raw_srt_seconds_from_timecode(
            item.get("source_end", item.get("end", source_start)),
            source_start,
        )
        if source_end <= source_start:
            source_end = source_start + 0.5

        visual_anchors = item.get("visual_anchor_seconds") or item.get("visual_anchors") or []
        clip_start, clip_end = _raw_srt_anchor_based_clip_range(
            source_start,
            source_end,
            narration,
            visual_anchors,
        )

        timestamp = f"{_raw_srt_format_seconds_mmss(clip_start)}-{_raw_srt_format_seconds_mmss(clip_end)}"
        source_timestamp = f"{_raw_srt_format_seconds_mmss(source_start)}-{_raw_srt_format_seconds_mmss(source_end)}"

        item["_id"] = idx
        item["id"] = item.get("id", idx)
        item["raw_srt_story_order"] = idx
        item["narration"] = narration
        item["text"] = narration
        item["start"] = clip_start
        item["end"] = clip_end
        item["duration"] = round(max(clip_end - clip_start, 0.5), 3)
        item["timestamp"] = timestamp
        item["source_start"] = clip_start
        item["source_end"] = clip_end
        item["source_timestamp"] = timestamp

        item["raw_srt_original_start"] = round(float(source_start), 3)
        item["raw_srt_original_end"] = round(float(source_end), 3)
        item["raw_srt_declared_start"] = round(float(source_start), 3)
        item["raw_srt_declared_end"] = round(float(source_end), 3)
        item["raw_srt_declared_duration"] = round(float(source_end - source_start), 3)
        item["source_original_timestamp"] = source_timestamp
        item["raw_srt_declared_timestamp"] = source_timestamp

        anchors = []
        for value in visual_anchors or []:
            try:
                sec = float(value)
            except Exception:
                continue
            anchors.append(round(sec, 3))
        item["visual_anchors"] = anchors
        item["visual_anchor_seconds"] = anchors
        item["visual_anchor_timestamps"] = [_raw_srt_format_seconds_mmss(v) for v in anchors]
        item["visual_anchor_policy"] = "expand_around_anchor_within_source_window"

        item["picture"] = item.get("picture") or narration[:80]
        item["generation_mode"] = item.get("generation_mode") or "raw_srt_two_round_narration"
        item["clip_match_rule"] = item.get("clip_match_rule") or "raw_srt_time_range"
        item["timeline_postprocess_mode"] = "raw_srt_anchor_based_first_cut"
        item["raw_srt_overlap_policy"] = "allow_overlap_no_drop"
        item["raw_srt_short_clip_policy"] = "anchor_expand_by_narration_length"
        item["char_budget"] = max(int(item.get("char_budget") or 0), len(narration) + 20)
        try:
            item["fit_check"] = fit_check(narration, item["duration"])
        except Exception:
            item["fit_check"] = {"fits": True, "actual": len(narration), "budget": len(narration) + 20, "severity": "ok"}

        result.append(item)

    return result


def _strip_raw_srt_timecode_calc_note(text):
    """Remove the timecode calculation note from narration text.

    Example to remove:
      （本段120字，朗读约需24秒，时间码跨度不低于MAX(24,30)秒=30秒，实际给出35秒）
    """
    if text is None:
        return text
    s = str(text)
    s = re.sub(
        r"^\s*[（(]\s*本段[^\n\r]*?(?:实际给出|时间码跨度|朗读约需)[^\n\r]*?[）)]\s*",
        "",
        s,
        flags=re.I,
    )
    s = re.sub(
        r"[（(]\s*本段\s*\d+\s*字[^\n\r]*?(?:实际给出|时间码跨度|朗读约需)[^\n\r]*?[）)]",
        "",
        s,
        flags=re.I,
    )
    return s.strip()

def _raw_srt_build_items(rows, *args, **kwargs):
    """Build script_items from parsed raw-SRT rows."""
    items = []

    def fmt(seconds):
        try:
            total = int(round(max(float(seconds or 0.0), 0.0)))
        except Exception:
            total = 0
        return f"{total // 60:02d}:{total % 60:02d}"

    for idx, row in enumerate(rows or [], start=1):
        if not isinstance(row, dict):
            continue

        narration = _raw_srt_clean_narration(row.get("narration") or row.get("text") or "")
        if not narration:
            continue

        try:
            start = float(row.get("start", row.get("source_start", 0.0)) or 0.0)
        except Exception:
            start = 0.0
        try:
            end = float(row.get("end", row.get("source_end", start)) or start)
        except Exception:
            end = start
        if end <= start:
            end = start + 0.5

        source_clips = row.get("source_clips") or row.get("raw_srt_source_clips") or []
        if not isinstance(source_clips, list):
            source_clips = []

        section_title = str(row.get("section_title") or row.get("title") or "").strip()
        item = {
            "_id": idx,
            "id": idx,
            "segment_id": idx,
            "scene_id": idx,
            "highlight_id": idx,
            "raw_srt_story_order": idx,
            "section_title": section_title,
            "title": section_title,
            "start": round(float(start), 3),
            "end": round(float(end), 3),
            "source_start": round(float(start), 3),
            "source_end": round(float(end), 3),
            "video_start": round(float(start), 3),
            "video_end": round(float(end), 3),
            "duration": round(float(end - start), 3),
            "timestamp": f"{fmt(start)}-{fmt(end)}",
            "source_timestamp": f"{fmt(start)}-{fmt(end)}",
            "picture": narration[:80],
            "narration": narration,
            "text": narration,
            "OST": 0,
            "composition_audio_mode": "tts",
            "generation_mode": "raw_srt_two_round_narration",
            "clip_match_rule": "raw_srt_time_range",
            "raw_srt_extract_mode": row.get("raw_srt_extract_mode") or "section_multiclip_v10_keep_opening",
            "timeline_postprocess_mode": "raw_srt_section_multiclip_safe_v10",
            "raw_srt_overlap_policy": "allow_overlap_no_drop",
            "raw_srt_preview_safe": True,
            "main_text_evidence": narration,
            "clip_text_evidence": narration[:120],
            "char_budget": max(len(narration) + 20, 80),
        }

        if source_clips:
            item["source_clips"] = source_clips
            item["raw_srt_source_clips"] = source_clips
            item["multi_clip"] = len(source_clips) > 1
            item["source_clip_count"] = len(source_clips)
            item["source_clip_total_duration"] = round(
                sum(float(c.get("duration", 0.0) or 0.0) for c in source_clips if isinstance(c, dict)),
                3,
            )

        items.append(item)

    return items






def _generate_raw_srt_narration_items(
    scene_evidence: List[Dict],
    *,
    raw_srt_text: str,
    api_key: str,
    base_url: str,
    model: str,
    style: str,
) -> List[Dict]:
    from app.services.movie_story.two_round_narration import run_two_round_narration_from_prompt

    prompt = _raw_srt_build_prompt(raw_srt_text, style=style)

    def call_llm(prompt_text: str) -> str:
        return _call_chat_completion(prompt_text, api_key=api_key, base_url=base_url, model=model, timeout=180)

    raw_text = run_two_round_narration_from_prompt(prompt, call_llm)
    rows = _raw_srt_extract_rows(raw_text)
    if not rows:
        raise ValueError("大模型未返回可解析的粗时间轴解说")
    items = _raw_srt_build_items(rows, scene_evidence or [], style=style)
    if not items:
        raise ValueError("粗时间轴解说解析后没有可执行片段")
    logger.warning("历史正剧原始SRT链路：双轮解说解析成功，items={}", len(items))
    return items


def generate_narration_from_scene_evidence(
    scene_evidence: List[Dict],
    api_key: str,
    base_url: str,
    model: str,
    style: str = "documentary",
    video_title: str = "",
    raw_subtitle_text: str = "",
    raw_subtitle_path: str = "",
    raw_subtitle_segments: List[Dict] | None = None,
    **kwargs,
) -> List[Dict]:
    normalized_style = style if style in STYLE_GUIDE else "default"
    if normalized_style in _FAST_CUT_STYLES:
        raw_srt_text = str(raw_subtitle_text or "")
        if not raw_srt_text and raw_subtitle_path:
            raw_srt_text = _raw_srt_read_file(raw_subtitle_path)
        if raw_srt_text and api_key and model:
            logger.warning(
                "历史正剧原始SRT链路：发送原始SRT进入双轮解说链路；srt_chars={}, scene_evidence_count={}",
                len(raw_srt_text),
                len(scene_evidence or []),
            )
            return _generate_raw_srt_narration_items(
                scene_evidence or [],
                raw_srt_text=raw_srt_text,
                api_key=api_key,
                base_url=base_url,
                model=model,
                style=normalized_style,
            )
        logger.warning(
            "历史正剧原始SRT链路未启用：raw_srt_text={}, api_key={}, model={}；回退原逻辑",
            bool(raw_srt_text),
            bool(api_key),
            bool(model),
        )

    return _ORIGINAL_GENERATE_NARRATION_FROM_SCENE_EVIDENCE(
        scene_evidence=scene_evidence,
        api_key=api_key,
        base_url=base_url,
        model=model,
        style=style,
        video_title=video_title,
    )
