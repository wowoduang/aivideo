def _pkg_start_end(pkg: Dict) -> tuple[float, float]:
    window = pkg.get("time_window", [0.0, 0.0]) or [0.0, 0.0]
    start_value = pkg.get("start", window[0] if isinstance(window, (list, tuple)) and window else 0.0)
    end_value = pkg.get("end", window[1] if isinstance(window, (list, tuple)) and len(window) > 1 else start_value)
    return coerce_time_pair(start_value, end_value, min_duration=1.0)


def _pkg_identity(pkg: Dict, idx: int) -> str:
    return str(
        pkg.get("segment_id")
        or pkg.get("highlight_id")
        or pkg.get("scene_id")
        or pkg.get("candidate_id")
        or f"seg_{idx:04d}"
    )


def _merge_text_values(rows: List[Dict], *keys: str, limit: int = 5000) -> str:
    parts: List[str] = []
    for row in rows:
        for key in keys:
            text = str(row.get(key) or "").strip()
            if text and text not in parts:
                parts.append(text)
                break
    return " ".join(parts)[:limit]


def _merge_list_values(rows: List[Dict], key: str, limit: int = 24) -> List:
    merged: List = []
    for row in rows:
        value = row.get(key)
        values = value if isinstance(value, list) else ([] if value is None else [value])
        for item in values:
            if item not in merged:
                merged.append(item)
            if len(merged) >= limit:
                return merged
    return merged


def _is_fast_cut_boundary(row: Dict) -> bool:
    text = str(row.get("plot_function") or row.get("story_function") or row.get("importance_level") or "")
    return any(token in text for token in ("反转", "转折", "冲突", "揭露", "爆发", "高潮", "high"))


def _build_fast_cut_package(rows: List[Dict], idx: int) -> Dict:
    first = dict(rows[0])
    start, _ = _pkg_start_end(rows[0])
    _, end = _pkg_start_end(rows[-1])
    source_ids = [_pkg_identity(row, pos) for pos, row in enumerate(rows, start=1)]
    pkg = dict(first)
    pkg["start"] = round(start, 3)
    pkg["end"] = round(end, 3)
    pkg["time_window"] = [round(start, 3), round(end, 3)]
    pkg["duration"] = round(max(end - start, 0.1), 3)
    pkg["timestamp"] = f"{utils.format_time(start)}-{utils.format_time(end)}"
    pkg["segment_id"] = f"historical_fast_cut_{idx:03d}"
    pkg["scene_id"] = pkg["segment_id"]
    pkg["highlight_id"] = pkg["segment_id"]
    pkg["source_segment_ids"] = list(dict.fromkeys(_merge_list_values(rows, "source_segment_ids") + source_ids))
    pkg["source_scene_ids"] = list(dict.fromkeys(_merge_list_values(rows, "source_scene_ids") + [str(row.get("scene_id") or "") for row in rows if row.get("scene_id")]))
    pkg["source_evidence_ids"] = list(dict.fromkeys(_merge_list_values(rows, "source_evidence_ids") + source_ids))
    pkg["subtitle_ids"] = _merge_list_values(rows, "subtitle_ids", limit=80)
    pkg["main_text_evidence"] = _merge_text_values(rows, "main_text_evidence", "subtitle_text", "source_text")
    pkg["subtitle_text"] = pkg["main_text_evidence"]
    pkg["visual_summary"] = _merge_list_values(rows, "visual_summary", limit=10)
    pkg["representative_frames"] = _merge_list_values(rows, "representative_frames", limit=8)
    pkg["frame_paths"] = _merge_list_values(rows, "frame_paths", limit=12)
    pkg["llm_highlight_selected"] = True
    pkg["highlight_filter_selected"] = True
    pkg["historical_fast_cut"] = True
    pkg["quick_cut_mode"] = "historical_drama_fast_timeline_cut"
    pkg["quick_cut_rule"] = "40_to_90_seconds_target_max_120_seconds"
    pkg["source_evidence_count"] = len(rows)
    pkg["plot_function"] = "历史剧快速粗切"
    pkg["importance_level"] = "high" if any(str(row.get("importance_level") or "") == "high" for row in rows) else "medium"
    pkg["llm_raw_voice_keep"] = True
    pkg["raw_voice_retain"] = True
    pkg["raw_voice_retain_suggestion"] = True
    pkg["audio_strategy"] = "keep"
    pkg["composition_audio_mode"] = "raw"
    if any(isinstance(row.get("_global_summary"), dict) for row in rows):
        pkg["_global_summary"] = next(row.get("_global_summary") for row in rows if isinstance(row.get("_global_summary"), dict))
    return pkg


def _coarse_merge_scene_evidence_for_fast_cut(scene_evidence: List[Dict], style: str) -> List[Dict]:
    if style not in _FAST_CUT_STYLES or len(scene_evidence or []) < 2:
        return list(scene_evidence or [])

    rows = [dict(row) for row in scene_evidence or [] if isinstance(row, dict)]
    rows.sort(key=lambda row: _pkg_start_end(row)[0])
    buckets: List[List[Dict]] = []
    current: List[Dict] = []

    def current_window() -> tuple[float, float]:
        if not current:
            return 0.0, 0.0
        s, _ = _pkg_start_end(current[0])
        _, e = _pkg_start_end(current[-1])
        return s, e

    for row in rows:
        row_start, row_end = _pkg_start_end(row)
        if row_end <= row_start:
            continue
        if not current:
            current = [row]
            continue

        cur_start, cur_end = current_window()
        cur_duration = cur_end - cur_start
        merged_duration = row_end - cur_start
        gap = row_start - cur_end
        should_close = False
        if gap > 8.0 and cur_duration >= 8.0:
            should_close = True
        elif cur_duration >= _FAST_CUT_MIN_SECONDS and _is_fast_cut_boundary(row):
            should_close = True
        elif cur_duration >= _FAST_CUT_MIN_SECONDS and merged_duration > _FAST_CUT_TARGET_SECONDS:
            should_close = True
        elif merged_duration > _FAST_CUT_MAX_SECONDS:
            should_close = True

        if should_close:
            buckets.append(current)
            current = [row]
        else:
            current.append(row)
    if current:
        buckets.append(current)

    return [_build_fast_cut_package(bucket, idx) for idx, bucket in enumerate(buckets, start=1)]


def _prepare_narration_packages(scene_evidence: List[Dict], style: str) -> List[Dict]:
    prepared: List[Dict] = []
    source_evidence = _coarse_merge_scene_evidence_for_fast_cut(scene_evidence, style)
    segment_count = len(source_evidence or [])
    for idx, raw in enumerate(source_evidence or [], start=1):
        pkg = dict(raw)
        pkg["is_opening_segment"] = bool(idx == 1)
        pkg["narration_style"] = style
        pkg["_narration_order"] = idx
        pkg["_narration_segment_key"] = _pkg_identity(pkg, idx)
        start, end = _pkg_start_end(pkg)
        duration = max(end - start, 0.1)
        if pkg.get("planned_char_budget"):
            char_budget = int(pkg.get("planned_char_budget") or 0)
        else:
            estimated = estimate_char_budget(duration, chars_per_second=5.2, reserve_ratio=0.85)
            char_budget = max(32, int(estimated))
            if duration < 4.5:
                char_budget = min(char_budget, 30)
        pkg["char_budget"] = char_budget
        pkg["_narration_segment_count"] = segment_count
        prepared.append(pkg)
    return prepared


def _visual_digest_for_prompt(pkg: Dict) -> List[str]:
    card = pkg.get("segment_visual_card") if isinstance(pkg.get("segment_visual_card"), dict) else {}
    points: List[str] = []
    for key in ("speakable_points", "observable_actions", "facial_expression"):
        for value in list(card.get(key) or [])[:3]:
            if str(value or "").strip():
                points.append(str(value).strip())
    if card.get("scene_environment"):
        points.append(str(card.get("scene_environment"))[:80])
    for item in list(pkg.get("visual_summary") or [])[:3]:
        if isinstance(item, dict) and item.get("desc"):
            points.append(str(item.get("desc"))[:80])
        elif isinstance(item, str):
            points.append(item[:80])
    return _unique_strings_local(points, limit=8)


def _unique_strings_local(values: List[str], limit: int = 20) -> List[str]:
    seen = set()
    out: List[str] = []
    for value in values:
        text = str(value or "").strip()
        if not text or text in seen:
            continue
        seen.add(text)
        out.append(text)
        if len(out) >= limit:
            break
    return out


def _build_full_subtitle_narration_prompt(
