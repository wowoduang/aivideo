    return any(token in compact for token in _ANALYSIS_CLICHES)


def _keyword_hits(text: str, words: List[str]) -> bool:
    return any(w in text for w in words)


def _variant_for_pkg(pkg: Dict, variants: List[str], salt: int = 0) -> str:
    if not variants:
        return ""
    start, _ = _pkg_start_end(pkg)
    seed_text = str(pkg.get("segment_id") or pkg.get("scene_id") or pkg.get("highlight_id") or "")
    seed = int(start * 10) + salt + sum(ord(ch) for ch in seed_text[-8:])
    return variants[seed % len(variants)]


