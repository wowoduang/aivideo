            "total_char_budget": total_char_budget,
        },
    )


def _build_source_timeline_json(scene_evidence: List[Dict], *, max_chars: int = 120000) -> str:
    rows = []
    total_text_chars = 0
    truncated = False
    for idx, item in enumerate(scene_evidence or [], start=1):
        if not isinstance(item, dict):
            continue
        start, end = _pkg_start_end(item)
        text = str(item.get("main_text_evidence") or item.get("subtitle_text") or item.get("source_text") or "").strip()
        if not text:
            continue
        row = {
            "order": idx,
            "source_segment_id": _pkg_identity(item, idx),
            "start": round(start, 3),
            "end": round(end, 3),
            "timestamp": item.get("timestamp") or f"{utils.format_time(start)}-{utils.format_time(end)}",
            "subtitle_text": text,
            "plot_function": item.get("plot_function"),
            "importance_level": item.get("importance_level"),
        }
        row_chars = len(json.dumps(row, ensure_ascii=False))
        if total_text_chars + row_chars > max_chars:
            truncated = True
            break
        rows.append(row)
        total_text_chars += row_chars
    payload = {
        "purpose": "whole_episode_subtitle_context_for_story_understanding",
        "rule": "先读完整字幕理解剧情，再按剪辑回填时间轴输出；不要逐句复述字幕。",
        "row_count": len(rows),
        "truncated": truncated,
        "items": rows,
    }
    return json.dumps(payload, ensure_ascii=False, indent=2)


def _normalize_sentence_rows(row: Dict, fallback_text: str, pkg: Dict) -> List[Dict]:
    raw_sentences = row.get("sentences")
    if not isinstance(raw_sentences, list):
        raw_sentences = []
    start, end = _pkg_start_end(pkg)
    normalized: List[Dict] = []
    for idx, sent in enumerate(raw_sentences, start=1):
        if not isinstance(sent, dict):
            continue
        text = str(sent.get("text") or sent.get("narration") or "").strip()
        if not text:
            continue
        s = coerce_seconds(sent.get("start", start), start)
        e = coerce_seconds(sent.get("end", end), end)
        if e <= s:
            e = min(end, s + max((end - start) / max(1, len(raw_sentences)), 0.5))
        normalized.append({
            "sentence_id": str(sent.get("sentence_id") or f"{pkg.get('_narration_segment_key')}_sent_{idx:02d}"),
            "text": text,
            "start": round(max(start, min(s, end)), 3),
            "end": round(max(start, min(e, end)), 3),
            "subtitle_ids": list(sent.get("subtitle_ids") or []),
            "char_budget": int(sent.get("char_budget") or max(12, len(text) + 8)),
            "rewrite_intent": str(sent.get("rewrite_intent") or ""),
        })
    if not normalized and fallback_text:
        normalized.append({
            "sentence_id": f"{pkg.get('_narration_segment_key')}_sent_01",
            "text": fallback_text,
            "start": round(start, 3),
            "end": round(end, 3),
            "subtitle_ids": list(pkg.get("subtitle_ids") or []),
            "char_budget": int(pkg.get("char_budget") or max(12, len(fallback_text) + 8)),
            "rewrite_intent": "segment_narration",
        })
    return normalized


def _parse_batch_narration_results(raw: str, packages: List[Dict], style: str, strategy_profile: Dict) -> Dict[str, Dict]:
    parsed = _extract_json_obj(raw)
    if isinstance(parsed, list):
        rows = parsed
    elif isinstance(parsed, dict) and isinstance(parsed.get("items"), list):
        rows = parsed.get("items") or []
    elif isinstance(parsed, dict) and isinstance(parsed.get("sentences"), list):
        grouped: Dict[str, Dict] = {}
        for sent in parsed.get("sentences") or []:
            if not isinstance(sent, dict):
                continue
            key = str(sent.get("segment_id") or "").strip()
            if not key:
                continue
            row = grouped.setdefault(key, {"segment_id": key, "sentences": []})
            row["sentences"].append(sent)
        for row in grouped.values():
            row["narration"] = "".join(str(s.get("text") or "") for s in row.get("sentences") or [])
        rows = list(grouped.values())
    else:
        return {}

    by_key: Dict[str, Dict] = {}
    package_by_key = {
        (pkg.get("_narration_segment_key") or _pkg_identity(pkg, idx)): pkg
        for idx, pkg in enumerate(packages, start=1)
    }
    order_to_key = {idx: key for idx, key in enumerate(package_by_key.keys(), start=1)}
    valid_keys = set(order_to_key.values())
    for row in rows:
        if not isinstance(row, dict):
            continue
        key = str(row.get("segment_id") or "").strip()
        if not key and row.get("order"):
            try:
                key = order_to_key.get(int(row.get("order")), "")
            except Exception:
                key = ""
        if not key or key not in valid_keys:
            continue
        narration = str(row.get("narration") or "").strip()
        pkg = package_by_key.get(key) or {}
        sentences = _normalize_sentence_rows(row, narration, pkg)
        if not narration and sentences:
            narration = "".join(str(sent.get("text") or "") for sent in sentences).strip()
        if not narration:
            continue
        by_key[key] = {
            "narration": narration,
            "narration_sentences": sentences,
            "raw_voice_keep": bool(row.get("raw_voice_keep", False)),
            "tone": row.get("tone") or "",
            "opening_type": row.get("opening_type") or "过渡",
            "risk_note": row.get("risk_note") or "full_subtitle_batch",
            "generation_mode": "full_subtitle_batch",
            "batch_style": style,
            "prompt_strategy_id": strategy_profile.get("strategy_id"),
            "prompt_strategy_label": strategy_profile.get("label"),
            "prompt_strategy_profile": strategy_profile,
        }
    return by_key


def _generate_full_subtitle_batch_narration(
    packages: List[Dict],
    *,
    source_evidence: List[Dict] | None = None,
    global_summary: Dict,
    project_context: Dict,
    style_guide: str,
    style_examples: str,
    movie_category: str,
    api_key: str,
    base_url: str,
    model: str,
    style: str,
) -> Dict[str, Dict]:
    if not (api_key and model and len(packages) >= 2):
        return {}
    total_budget = sum(int(pkg.get("char_budget") or 80) for pkg in packages)
    expected_total = len(packages)
    source_text = " ".join(str(pkg.get("main_text_evidence") or pkg.get("subtitle_text") or "") for pkg in packages)
    best_result: Dict[str, Dict] = {}
    best_report: Dict = {"score": -1.0}
    best_strategy: Dict = {}
    candidates = get_candidate_prompt_strategies(movie_category, stage="subtitle_draft", max_candidates=3)

    for strategy_profile in candidates:
        prompt = _build_full_subtitle_narration_prompt(
            packages,
            source_evidence=source_evidence or packages,
            global_summary=global_summary,
            project_context=project_context,
            style_guide=style_guide,
            style_examples=style_examples,
            strategy_profile=strategy_profile,
            total_char_budget=total_budget,
        )
        raw = _call_chat_completion(
            prompt,
            api_key=api_key,
            base_url=base_url,
            model=model,
            timeout=160,
        )
        result = _parse_batch_narration_results(raw, packages, style, strategy_profile)
        score_report = score_narration_items(result.values(), source_text=source_text, expected_total=expected_total)
        record_prompt_strategy_result(
            movie_category=movie_category,
            strategy_id=str(strategy_profile.get("strategy_id") or ""),
            stage="subtitle_draft",
            score_report=score_report,
            sample={
                "video_title": project_context.get("video_title"),
                "style": style,
                "items_preview": list(result.values())[:5],
            },
        )
        if float(score_report.get("score", 0.0) or 0.0) > float(best_report.get("score", -1.0) or -1.0):
            best_result = result
            best_report = score_report
            best_strategy = strategy_profile

    for row in best_result.values():
        row["prompt_strategy_selected"] = True
        row["prompt_strategy_score"] = best_report.get("score")
        row["prompt_strategy_score_report"] = best_report
        row["prompt_strategy_candidate_count"] = len(candidates)
        row["prompt_strategy_id"] = best_strategy.get("strategy_id")
        row["prompt_strategy_label"] = best_strategy.get("label")
        row["prompt_strategy_profile"] = best_strategy
    return best_result



