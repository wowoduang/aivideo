            pkg.get("picture")
            or "；".join(
                str(x.get("desc") or x.get("description") or "")
                for x in (pkg.get("visual_summary") or [])[:2]
                if isinstance(x, dict)
            )
            or str(pkg.get("main_text_evidence") or pkg.get("subtitle_text") or "")[:80]
            or "按字幕时间切原片"
        )
        generation_result = _missing_narration_original_audio(pkg)
