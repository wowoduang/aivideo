import { useMemo, useState } from 'react';

import {
  buildBoundSpeakerContext,
  previewSpeakerContext,
  runFunasrSpeakerPreview,
  type SpeakerPreview,
} from '../../lib/speaker-context-api';

type RoleMap = Record<string, string>;

type SpeakerContextPanelProps = {
  mediaPath?: string;
  subtitleSegments?: Array<Record<string, unknown>>;
};

const ALIYUN_JSON_EXAMPLE = `{
  "transcripts": [
    {
      "sentences": [
        {
          "begin_time": 284000,
          "end_time": 288000,
          "text": "我要天天吃大饼",
          "speaker_id": 0
        }
      ]
    }
  ]
}`;

const SUBTITLE_SEGMENTS_EXAMPLE = `[
  {
    "start": 284,
    "end": 288,
    "text": "我要天天吃大饼"
  }
]`;

function parseJsonObject(value: string): Record<string, unknown> {
  const parsed = JSON.parse(value);
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
    throw new Error('阿里云识别结果必须是 JSON object');
  }
  return parsed as Record<string, unknown>;
}

function parseJsonArray(value: string): Array<Record<string, unknown>> {
  const parsed = JSON.parse(value);
  if (!Array.isArray(parsed)) {
    throw new Error('字幕片段必须是 JSON array');
  }
  return parsed as Array<Record<string, unknown>>;
}

function cleanRoleMap(roleMap: RoleMap): RoleMap {
  return Object.fromEntries(
    Object.entries(roleMap)
      .map(([speakerId, roleName]) => [speakerId, roleName.trim()])
      .filter(([, roleName]) => roleName),
  );
}

export function SpeakerContextPanel({
  mediaPath = '',
  subtitleSegments = [],
}: SpeakerContextPanelProps): JSX.Element {
  const [aliyunJsonText, setAliyunJsonText] = useState(ALIYUN_JSON_EXAMPLE);
  const [subtitleSegmentsText, setSubtitleSegmentsText] = useState(SUBTITLE_SEGMENTS_EXAMPLE);
  const [preview, setPreview] = useState<SpeakerPreview | null>(null);
  const [rawAliyunResult, setRawAliyunResult] = useState<Record<string, unknown> | null>(null);
  const [roleMap, setRoleMap] = useState<RoleMap>({});
  const [speakerContext, setSpeakerContext] = useState('');
  const [errorMessage, setErrorMessage] = useState('');
  const [showDebugInput, setShowDebugInput] = useState(false);
  const [busy, setBusy] = useState(false);

  const statusText = useMemo(() => {
    if (!preview) return '未生成';
    return `${preview.speaker_count} 个 SPEAKER`;
  }, [preview]);

  async function handleAutoPreview(): Promise<void> {
    setBusy(true);
    setErrorMessage('');
    try {
      if (!mediaPath) {
        throw new Error('当前项目缺少可用于说话人识别的音频路径，请先完成字幕识别或展开调试输入。');
      }
      const response = await runFunasrSpeakerPreview({
        audio_path: mediaPath,
        max_examples_per_speaker: 5,
      });
      setPreview(response.data.speaker_preview);
      setRawAliyunResult(response.data.aliyun_result_json);
      seedRoleMap(response.data.speaker_preview);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  async function handleDebugPreview(): Promise<void> {
    setBusy(true);
    setErrorMessage('');
    try {
      const aliyunResult = parseJsonObject(aliyunJsonText);
      const response = await previewSpeakerContext({
        aliyun_result_json: aliyunResult,
        max_examples_per_speaker: 5,
      });
      setPreview(response.data.speaker_preview);
      setRawAliyunResult(aliyunResult);
      seedRoleMap(response.data.speaker_preview);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  async function handleBuild(): Promise<void> {
    setBusy(true);
    setErrorMessage('');
    try {
      const effectiveAliyunResult = rawAliyunResult ?? parseJsonObject(aliyunJsonText);
      const effectiveSubtitleSegments = subtitleSegments.length
        ? subtitleSegments
        : parseJsonArray(subtitleSegmentsText);
      const response = await buildBoundSpeakerContext({
        subtitle_segments: effectiveSubtitleSegments,
        aliyun_result_json: effectiveAliyunResult,
        speaker_role_map: cleanRoleMap(roleMap),
      });
      setSpeakerContext(response.data.speaker_context);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  function seedRoleMap(nextPreview: SpeakerPreview): void {
    setRoleMap((current) => {
      const next = { ...current };
      nextPreview.speakers.forEach((speaker) => {
        if (!(speaker.speaker_id in next)) {
          next[speaker.speaker_id] = '';
        }
      });
      return next;
    });
  }

  return (
    <section className="mt-6 rounded-2xl border border-white/[0.06] bg-[#0a0a0f] p-6 shadow-[0_0_0_1px_rgba(70,236,19,0.03)]">
      <div className="flex flex-wrap items-start justify-between gap-4 border-b border-white/[0.06] pb-4">
        <div>
          <div className="flex items-center gap-2">
            <span className="h-2.5 w-2.5 rounded-full bg-[#46ec13] shadow-[0_0_14px_rgba(70,236,19,0.55)]" />
            <h3 className="text-lg font-semibold text-white">说话人识别与角色绑定</h3>
          </div>
          <p className="mt-1 max-w-3xl text-sm text-white/55">
            复用字幕识别阶段的阿里 Fun-ASR / OSS filetrans 链路生成 SPEAKER 预览，再把 SPEAKER_00 / SPEAKER_01 绑定成角色名。
          </p>
        </div>
        <span className="rounded-full border border-[#46ec13]/25 bg-[#46ec13]/10 px-3 py-1 text-xs font-medium text-[#46ec13]">
          {statusText}
        </span>
      </div>

      <div className="mt-5 flex flex-wrap items-center gap-3">
        <button
          className="rounded-xl bg-[#46ec13] px-4 py-2 text-sm font-semibold text-[#060a07] transition hover:bg-[#37c00c] disabled:cursor-not-allowed disabled:opacity-50"
          type="button"
          disabled={busy}
          onClick={() => void handleAutoPreview()}
        >
          自动生成说话人识别
        </button>
        <button
          className="rounded-xl border border-white/[0.08] bg-white/[0.06] px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/[0.1] disabled:cursor-not-allowed disabled:opacity-50"
          type="button"
          disabled={busy || !preview}
          onClick={() => void handleBuild()}
        >
          生成 speaker_context
        </button>
        <button
          className="rounded-xl px-3 py-2 text-sm text-white/50 transition hover:bg-white/[0.05] hover:text-white"
          type="button"
          onClick={() => setShowDebugInput((value) => !value)}
        >
          {showDebugInput ? '收起调试输入' : '展开调试输入'}
        </button>
      </div>

      <div className="mt-3 text-xs text-white/35">
        当前媒体路径：{mediaPath || '暂无，需先完成上传/字幕识别'}
      </div>

      {showDebugInput ? (
        <div className="mt-5 grid gap-4 lg:grid-cols-2">
          <label className="flex flex-col gap-2 text-sm font-medium text-white/80">
            阿里 Fun-ASR JSON
            <textarea
              className="min-h-40 rounded-xl border border-white/[0.08] bg-black/35 p-3 font-mono text-xs text-white/80 outline-none transition focus:border-[#46ec13]/60 focus:ring-2 focus:ring-[#46ec13]/10"
              value={aliyunJsonText}
              onChange={(event) => setAliyunJsonText(event.target.value)}
              spellCheck={false}
            />
          </label>
          <label className="flex flex-col gap-2 text-sm font-medium text-white/80">
            subtitle_segments
            <textarea
              className="min-h-40 rounded-xl border border-white/[0.08] bg-black/35 p-3 font-mono text-xs text-white/80 outline-none transition focus:border-[#46ec13]/60 focus:ring-2 focus:ring-[#46ec13]/10"
              value={subtitleSegmentsText}
              onChange={(event) => setSubtitleSegmentsText(event.target.value)}
              spellCheck={false}
            />
          </label>
          <button
            className="rounded-xl border border-white/[0.08] bg-white/[0.06] px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/[0.1] disabled:cursor-not-allowed disabled:opacity-50"
            type="button"
            disabled={busy}
            onClick={() => void handleDebugPreview()}
          >
            用调试 JSON 生成预览
          </button>
        </div>
      ) : null}

      {errorMessage ? (
        <div className="mt-4 rounded-xl border border-red-400/25 bg-red-500/10 p-3 text-sm text-red-200">
          {errorMessage}
        </div>
      ) : null}

      {preview ? (
        <div className="mt-5 space-y-3">
          {preview.speakers.map((speaker) => (
            <div className="rounded-xl border border-white/[0.08] bg-white/[0.03] p-4" key={speaker.speaker_id}>
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <div className="font-mono text-sm font-semibold text-[#46ec13]">
                    {speaker.speaker_id}
                  </div>
                  <div className="mt-1 text-xs text-white/45">
                    总时长 {speaker.total_duration.toFixed(1)} 秒 · {speaker.segment_count} 段
                  </div>
                </div>
                <input
                  className="w-52 rounded-lg border border-white/[0.08] bg-black/30 px-3 py-2 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-[#46ec13]/60 focus:ring-2 focus:ring-[#46ec13]/10"
                  placeholder="绑定角色名"
                  value={roleMap[speaker.speaker_id] ?? ''}
                  onChange={(event) => {
                    const value = event.target.value;
                    setRoleMap((current) => ({ ...current, [speaker.speaker_id]: value }));
                  }
                />
              </div>
              <div className="mt-3 space-y-2">
                {speaker.examples.map((example) => (
                  <div className="rounded-lg border border-white/[0.06] bg-black/25 p-2 text-xs text-white/70" key={`${speaker.speaker_id}-${example.start}-${example.end}`}>
                    <span className="font-mono text-white/40">{example.start}~{example.end}</span>
                    <span className="ml-2">{example.text || '无文本样例'}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : null}

      {speakerContext ? (
        <label className="mt-5 flex flex-col gap-2 text-sm font-medium text-white/80">
          {'{speaker_context}'}
          <textarea
            className="min-h-40 rounded-xl border border-[#46ec13]/20 bg-black/50 p-3 font-mono text-xs text-[#d8ffd0] outline-none"
            value={speakerContext}
            readOnly
            spellCheck={false}
          />
        </label>
      ) : null}
    </section>
  );
}
