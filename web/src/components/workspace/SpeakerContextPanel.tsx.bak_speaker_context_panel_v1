import { useMemo, useState } from 'react';

import {
  buildBoundSpeakerContext,
  previewSpeakerContext,
  type SpeakerPreview,
} from '../../lib/speaker-context-api';

type RoleMap = Record<string, string>;

const ALIYUN_JSON_EXAMPLE = `{
  "transcripts": [
    {
      "sentences": [
        {
          "begin_time": 284000,
          "end_time": 288000,
          "text": "我要天天吃大饼",
          "speaker_id": 0
        }
      ]
    }
  ]
}`;

const SUBTITLE_SEGMENTS_EXAMPLE = `[
  {
    "start": 284,
    "end": 288,
    "text": "我要天天吃大饼"
  }
]`;

function parseObject(value: string): Record<string, unknown> {
  const parsed = JSON.parse(value);
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
    throw new Error('阿里云识别结果必须是 JSON object');
  }
  return parsed as Record<string, unknown>;
}

function parseArray(value: string): Array<Record<string, unknown>> {
  const parsed = JSON.parse(value);
  if (!Array.isArray(parsed)) {
    throw new Error('字幕片段必须是 JSON array');
  }
  return parsed as Array<Record<string, unknown>>;
}

function cleanRoleMap(roleMap: RoleMap): RoleMap {
  return Object.fromEntries(
    Object.entries(roleMap)
      .map(([speakerId, roleName]) => [speakerId, roleName.trim()])
      .filter(([, roleName]) => roleName),
  );
}

export function SpeakerContextPanel(): JSX.Element {
  const [aliyunJsonText, setAliyunJsonText] = useState(ALIYUN_JSON_EXAMPLE);
  const [subtitleSegmentsText, setSubtitleSegmentsText] = useState(SUBTITLE_SEGMENTS_EXAMPLE);
  const [preview, setPreview] = useState<SpeakerPreview | null>(null);
  const [roleMap, setRoleMap] = useState<RoleMap>({});
  const [speakerContext, setSpeakerContext] = useState('');
  const [errorMessage, setErrorMessage] = useState('');
  const [busy, setBusy] = useState(false);

  const statusText = useMemo(() => {
    if (!preview) return '未生成';
    return `${preview.speaker_count} 个 SPEAKER`;
  }, [preview]);

  async function handlePreview(): Promise<void> {
    setBusy(true);
    setErrorMessage('');
    try {
      const response = await previewSpeakerContext({
        aliyun_result_json: parseObject(aliyunJsonText),
        max_examples_per_speaker: 5,
      });
      setPreview(response.data.speaker_preview);
      setRoleMap((current) => {
        const next = { ...current };
        response.data.speaker_preview.speakers.forEach((speaker) => {
          if (!(speaker.speaker_id in next)) next[speaker.speaker_id] = '';
        });
        return next;
      });
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  async function handleBuild(): Promise<void> {
    setBusy(true);
    setErrorMessage('');
    try {
      const response = await buildBoundSpeakerContext({
        subtitle_segments: parseArray(subtitleSegmentsText),
        aliyun_result_json: parseObject(aliyunJsonText),
        speaker_role_map: cleanRoleMap(roleMap),
      });
      setSpeakerContext(response.data.speaker_context);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  return (
    <section className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <div className="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-3">
        <div>
          <h3 className="text-base font-semibold text-slate-900">说话人识别</h3>
          <p className="text-sm text-slate-500">
            阿里 Fun-ASR speaker_id 预览、角色绑定、生成第一轮 speaker_context。
          </p>
        </div>
        <span className="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600">
          {statusText}
        </span>
      </div>

      <div className="mt-4 grid gap-4 lg:grid-cols-2">
        <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
          阿里 Fun-ASR JSON
          <textarea
            className="min-h-40 rounded-xl border border-slate-200 bg-slate-50 p-3 font-mono text-xs"
            value={aliyunJsonText}
            onChange={(event) => setAliyunJsonText(event.target.value)}
            spellCheck={false}
          />
        </label>
        <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
          subtitle_segments
          <textarea
            className="min-h-40 rounded-xl border border-slate-200 bg-slate-50 p-3 font-mono text-xs"
            value={subtitleSegmentsText}
            onChange={(event) => setSubtitleSegmentsText(event.target.value)}
            spellCheck={false}
          />
        </label>
      </div>

      <div className="mt-4 flex flex-wrap gap-3">
        <button
          className="rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white disabled:bg-slate-400"
          type="button"
          disabled={busy}
          onClick={() => void handlePreview()}
        >
          生成 SPEAKER 预览
        </button>
        <button
          className="rounded-xl bg-blue-600 px-4 py-2 text-sm font-medium text-white disabled:bg-blue-300"
          type="button"
          disabled={busy}
          onClick={() => void handleBuild()}
        >
          生成 speaker_context
        </button>
      </div>

      {errorMessage ? (
        <div className="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {errorMessage}
        </div>
      ) : null}

      {preview ? (
        <div className="mt-4 space-y-3">
          {preview.speakers.map((speaker) => (
            <div className="rounded-xl border border-slate-200 bg-slate-50 p-3" key={speaker.speaker_id}>
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <div className="font-mono text-sm font-semibold text-slate-900">
                    {speaker.speaker_id}
                  </div>
                  <div className="text-xs text-slate-500">
                    总时长 {speaker.total_duration.toFixed(1)} 秒 · {speaker.segment_count} 段
                  </div>
                </div>
                <input
                  className="w-48 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm"
                  placeholder="绑定角色名"
                  value={roleMap[speaker.speaker_id] ?? ''}
                  onChange={(event) => {
                    const value = event.target.value;
                    setRoleMap((current) => ({ ...current, [speaker.speaker_id]: value }));
                  }}
                />
              </div>
              <div className="mt-3 space-y-2">
                {speaker.examples.map((example) => (
                  <div className="rounded-lg bg-white p-2 text-xs text-slate-700" key={`${speaker.speaker_id}-${example.start}-${example.end}`}>
                    <span className="font-mono text-slate-500">{example.start}~{example.end}</span>
                    <span className="ml-2">{example.text || '无文本样例'}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : null}

      {speakerContext ? (
        <label className="mt-4 flex flex-col gap-2 text-sm font-medium text-slate-700">
          {'{speaker_context}'}
          <textarea
            className="min-h-40 rounded-xl border border-slate-200 bg-slate-950 p-3 font-mono text-xs text-slate-50"
            value={speakerContext}
            readOnly
            spellCheck={false}
          />
        </label>
      ) : null}
    </section>
  );
}
