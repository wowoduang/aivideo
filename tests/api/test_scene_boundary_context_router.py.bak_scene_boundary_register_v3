# -*- coding: utf-8 -*-
from __future__ import annotations

"""
test_scene_boundary_context_router.py

测试 scene_boundary_context router。
"""

import unittest
from unittest.mock import patch

from fastapi import FastAPI
from fastapi.testclient import TestClient

from app.api.routers.scene_boundary_context import router


class TestSceneBoundaryContextRouter(unittest.TestCase):
    """scene_boundary_context router 测试。"""

    def setUp(self) -> None:
        """创建临时 FastAPI app。"""
        app = FastAPI()
        app.include_router(router)
        self.client = TestClient(app)

    def test_preview_success(self) -> None:
        """预览接口成功返回 scene_boundary_context。"""
        with patch(
            "app.api.routers.scene_boundary_context.build_scene_boundary_context_preview_payload",
            return_value={
                "scene_count": 1,
                "shot_detection": {"shot_count": 2},
                "scene_boundaries": [{"scene_id": "scene_001"}],
                "scene_boundary_context": "scene_001 | 00:00~00:10 | 10秒",
            },
        ) as mocked:
            response = self.client.post(
                "/api/v1/scene-boundary-context/preview",
                json={
                    "video_path": "E:/aivideo-workspace/frontend_uploads/video/demo.mp4",
                    "subtitle_segments": [{"start": 0, "end": 10, "text": "测试"}],
                    "visual_anchors": [],
                },
            )

        self.assertEqual(response.status_code, 200)
        data = response.json()
        self.assertEqual(data["scene_count"], 1)
        self.assertIn("scene_001", data["scene_boundary_context"])
        mocked.assert_called_once()

    def test_preview_value_error_returns_422(self) -> None:
        """服务层 ValueError 转为 422。"""
        with patch(
            "app.api.routers.scene_boundary_context.build_scene_boundary_context_preview_payload",
            side_effect=ValueError("subtitle_segments 为空"),
        ):
            response = self.client.post(
                "/api/v1/scene-boundary-context/preview",
                json={
                    "video_path": "demo.mp4",
                    "subtitle_segments": [{"start": 0, "end": 1, "text": "x"}],
                },
            )

        self.assertEqual(response.status_code, 422)
        self.assertIn("subtitle_segments 为空", response.json()["detail"])

    def test_preview_runtime_error_returns_500(self) -> None:
        """服务层 RuntimeError 转为 500，不静默成功。"""
        with patch(
            "app.api.routers.scene_boundary_context.build_scene_boundary_context_preview_payload",
            side_effect=RuntimeError("PySceneDetect 未返回任何镜头边界"),
        ):
            response = self.client.post(
                "/api/v1/scene-boundary-context/preview",
                json={
                    "video_path": "demo.mp4",
                    "subtitle_segments": [{"start": 0, "end": 1, "text": "x"}],
                },
            )

        self.assertEqual(response.status_code, 500)
        self.assertIn("PySceneDetect 未返回任何镜头边界", response.json()["detail"])

    def test_preview_schema_error_returns_422(self) -> None:
        """Pydantic 入参格式错误返回 422。"""
        response = self.client.post(
            "/api/v1/scene-boundary-context/preview",
            json={
                "video_path": "demo.mp4",
                "subtitle_segments": [],
                "target_scene_count": 0,
            },
        )

        self.assertEqual(response.status_code, 422)


if __name__ == "__main__":
    unittest.main()
