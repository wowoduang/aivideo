# -*- coding: utf-8 -*-
from __future__ import annotations

"""
test_scene_boundary_source_time_strings.py

确认 scene_boundary_source 能接受前端 SubtitleLine 的字符串时间格式。
"""

import unittest

from app.services.movie_story.scene_boundary_source import infer_story_range_from_subtitles


class TestSceneBoundarySourceTimeStrings(unittest.TestCase):
    """字幕时间字符串解析测试。"""

    def test_infer_story_range_from_srt_like_time_strings(self) -> None:
        """支持 00:01:48.316 / 00:01:53.436 这种前端字幕时间。"""
        start, end = infer_story_range_from_subtitles(
            [
                {
                    "id": 1,
                    "start": "00:01:48.316",
                    "end": "00:01:53.436",
                    "text": "在中华王朝史上，有一个屡见不鲜的现象。",
                },
                {
                    "id": 2,
                    "start": "00:02:00.000",
                    "end": "00:02:05.500",
                    "text": "第二句。",
                },
            ]
        )

        self.assertAlmostEqual(start, 108.316, places=3)
        self.assertAlmostEqual(end, 125.5, places=3)

    def test_invalid_time_string_raises(self) -> None:
        """非法时间字符串直接报错。"""
        with self.assertRaises(ValueError):
            infer_story_range_from_subtitles(
                [{"start": "bad-time", "end": "00:00:01.000", "text": "x"}]
            )


if __name__ == "__main__":
    unittest.main()
