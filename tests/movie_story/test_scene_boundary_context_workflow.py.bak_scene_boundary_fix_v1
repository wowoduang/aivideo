# -*- coding: utf-8 -*-
from __future__ import annotations

"""
test_scene_boundary_context_workflow.py

测试 scene_boundary_context 本地规则工作流。
"""

import unittest

from app.services.movie_story.scene_boundary_context_workflow import build_scene_boundary_payload
from app.services.movie_story.scene_boundary_context_workflow import build_scene_boundaries


class TestSceneBoundaryContextWorkflow(unittest.TestCase):
    """scene_boundary_context 工作流测试。"""

    def test_without_visual_anchor_does_not_invent_facts(self) -> None:
        """没有视觉锚点时，不能从字幕编造画面事实。"""
        payload = build_scene_boundary_payload(
            subtitle_segments=[
                {"start": 0, "end": 10, "text": "欠税不交就拿稻种喂马"},
                {"start": 70, "end": 80, "text": "娘 我一定会回来"},
            ],
            shot_boundaries=[
                {"start": 0, "end": 40},
                {"start": 40, "end": 90},
            ],
            target_scene_count=2,
            min_scene_duration=20,
            max_scene_duration=90,
        )

        self.assertEqual(payload["scene_count"], 1)
        self.assertIn("画面事实：未提供视觉锚点，不能从字幕推断画面事实", payload["scene_boundary_context"])
        self.assertIn("字幕关键词：", payload["scene_boundary_context"])

    def test_with_visual_anchor(self) -> None:
        """有视觉锚点时，能格式化画面事实和在场人物。"""
        payload = build_scene_boundary_payload(
            subtitle_segments=[
                {"start": 464, "end": 472, "text": "欠税不交 稻种拿去喂马"},
                {"start": 480, "end": 488, "text": "求官爷开恩"},
            ],
            shot_boundaries=[
                {"start": 460, "end": 490},
            ],
            visual_anchors=[
                {
                    "time": 472,
                    "description": "官兵靠近屋内物品",
                    "confidence": 0.76,
                    "people": [{"name": "官兵", "confidence": 0.86}, {"name": "母亲", "confidence": 0.78}],
                }
            ],
            target_scene_count=1,
            min_scene_duration=10,
            max_scene_duration=60,
        )

        context = payload["scene_boundary_context"]
        self.assertIn("scene_001 | 07:40~08:10 | 30秒", context)
        self.assertIn("在场人物：官兵(0.86) 母亲(0.78)", context)
        self.assertIn("画面事实：官兵靠近屋内物品", context)
        self.assertIn("画面锚点：07:52 官兵靠近屋内物品(0.76)", context)

    def test_split_long_scene_by_subtitles(self) -> None:
        """过长场景会被字幕时间继续拆分。"""
        subtitles = [
            {"start": second, "end": second + 5, "text": f"片段{second}"}
            for second in range(0, 420, 60)
        ]
        scenes = build_scene_boundaries(
            subtitle_segments=subtitles,
            shot_boundaries=[{"start": 0, "end": 420}],
            min_scene_duration=30,
            max_scene_duration=150,
        )

        self.assertGreaterEqual(len(scenes), 2)
        self.assertTrue(all(scene.duration <= 180 for scene in scenes))


if __name__ == "__main__":
    unittest.main()
